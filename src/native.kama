file @compileFor(!ARCH_WASM32);
// ui::native — the native UI backend: RmlUi through @kama/rmlui, which records draw commands rather than drawing.
//
// The seam once called its own C++ shim directly. That shim is now @kama/rmlui, made general; this file is the SEAM'S
// POLICY on top of it, which the shim used to carry in C++:
//   - one RmlUi context per UiContext, one document at a time, shown with its `autofocus` element focused;
//   - `bindElement` is a @kama/rmlui BINDING listening for click and change — the same handle for the same id while the
//     document lives, re-finding its element (and moving its listeners) after a rewrite; an event's target is the
//     binding of the nearest element with an id, named at the poll without listening;
//   - the keyboard is the GLFW-numbered table in types.kama, translated here to RmlUi's own keys, with "a navigation key
//     with nothing focused lands on the first tab element";
//   - `update` steps the clock 1/60 s; writes into controls are quiet;
//   - (0.3.0) the package's own listeners on the document's root — keys, the drag's progress, scrolling — whose events
//     `pollEvent` turns into `Key` events and the drag's classes; `draggable="true"` given RCSS `drag: drag-drop`; and
//     the tooltip, an element the package appends to every document and shows from `update`;
//   - (0.4.0) the files (host.kama): every list, read and save request the program provided or asked for, and the
//     events they raise, in a `FileStore` on the heap behind the context's `store` pointer — the one piece of state
//     here that is not RmlUi's — made when the UI starts and dropped at `close`;
//   - (0.5.0) media playback answers None and false: RmlUi has no media element (host.kama, "media").
//
// ⚠️ ONE GATE, ON THE FILE. A package build compiles every source under its root regardless of imports, so this file
// would reach the wasm leg too; the whole-unit gate (kama 0.9.150) keeps it — and its import of @kama/rmlui — out. The
// mirror of this line is what lets web.kama import `std::fs` and `ui::uidoc`.
//
// A `value`, not a `resource`: every field is a handle into state RmlUi owns, there is one UI per screen stack, and
// `close()` is explicit. Every method tolerates `ready == 0` (a UI that would not start is not worth failing a game over).

import {
    UiHost, UiCommand, UiCommandKind, UiTexture, UiEvent, UiEventKind, UiRect,
    UI_KEY_ESCAPE, UI_KEY_ENTER, UI_KEY_TAB, UI_KEY_BACKSPACE, UI_KEY_DELETE, UI_KEY_RIGHT, UI_KEY_LEFT, UI_KEY_DOWN,
    UI_KEY_UP, UI_KEY_PAGE_UP, UI_KEY_PAGE_DOWN, UI_KEY_HOME, UI_KEY_END, UI_KEY_F1, UI_KEY_F12, UI_KEY_A, UI_KEY_Z,
    UI_KEY_0, UI_KEY_9, UI_MOD_SHIFT, UI_MOD_CTRL, UI_MOD_ALT, UI_TOOLTIP_DELAY,
    rmlui::RmlUi, rmlui::RmlUiError, rmlui::Context, rmlui::Document, rmlui::Element, rmlui::Binding, rmlui::Event,
    rmlui::Listener, rmlui::EventType, rmlui::Command, rmlui::CommandKind, rmlui::Texture, rmlui::Rect, rmlui::BoxArea,
    rmlui::Modal, rmlui::Focus, rmlui::LISTEN_BUBBLE, rmlui::LISTEN_CAPTURE,
    rmlui::KEY_RETURN, rmlui::KEY_NUMPAD_ENTER, rmlui::KEY_TAB, rmlui::KEY_BACKSPACE, rmlui::KEY_DELETE,
    rmlui::KEY_RIGHT, rmlui::KEY_LEFT, rmlui::KEY_DOWN, rmlui::KEY_UP, rmlui::KEY_HOME, rmlui::KEY_END,
    rmlui::KEY_ESCAPE, rmlui::KEY_PAGE_UP, rmlui::KEY_PAGE_DOWN, rmlui::KEY_F1, rmlui::KEY_F12, rmlui::KEY_A,
    rmlui::KEY_Z, rmlui::KEY_0, rmlui::KEY_9,
    rmlui::MOD_NONE, rmlui::MOD_SHIFT, rmlui::MOD_CTRL, rmlui::MOD_ALT, rmlui::MOD_META,
    uiFileType,
    std::collections::ConstView, std::collections::DynamicArray,
    std::fs::File, std::fs::OpenMode, std::fs::Metadata, std::fs::stat, std::io::IoError,
    std::path::fileName, std::memory::Owned, std::memory::replace,
    std::fmt::parse, std::fmt::ParseError,
};
export { UiContext };

// ---- 0.4.0: files ----

// ⚠️ std's `File` has no seek (KAMA_GAPS.md), and a slice of a large file must not cost reading what comes before it:
// a read starts its descriptor with the C library's own positioned seek (declared by kama_ui_native.h).
extern "kama_ui_native.h";
@compileFor(!OS_WINDOWS)
extern fn int64 lseek(int32 fd, int64 offset, int32 whence);
@compileFor(OS_WINDOWS)
extern fn int64 _lseeki64(int32 fd, int64 offset, int32 whence);
@compileFor(!OS_WINDOWS)
unsafe fn int64 seekTo(int32 fd, int64 offset) { return lseek(fd: fd, offset: offset, whence: 0); }
@compileFor(OS_WINDOWS)
unsafe fn int64 seekTo(int32 fd, int64 offset) { return _lseeki64(fd: fd, offset: offset, whence: 0); }

comptime int32 FILE_LIST = 1;
comptime int32 FILE_READ = 2;
comptime int32 FILE_SAVE = 3;
comptime int32 CHOSEN_MANY = 1;     // a chooser's flags: it takes several files,
comptime int32 CHOSEN_ASKED = 2;    // the program has not taken it yet (`takeFileRequest`),
comptime int32 CHOSEN_OPEN = 4;     // and it has not been answered (`provideFiles`)

// A file's size from the file system, -1 when it cannot be read.
unsafe fn int64 sizeOf(const ref string path)
{
    Result<Metadata, IoError> m = stat(path: path);
    return match (m) { case Ok(value: x): cast<int64>(x.size); case Err(error: e): -1; };
}

// Bytes `offset` to `offset + count` of the file at `path` (fewer at its end) into `into`, or why not.
unsafe fn string readSlice(const ref string path, int64 offset, int32 count, ref DynamicArray<uint8> into)
{
    into.clear();
    Result<File, IoError> opened = File.open(path: path, mode: OpenMode::Read);
    File f = match (give opened) {
        case Ok(value: x): give x;
        case Err(error: e): {
            string m = e.message();
            return "${path}: ${m}";
        }
    };
    if (offset > 0 && seekTo(fd: f.rawFd(), offset: offset) != offset) { return "${path}: cannot start at ${offset}"; }
    isize want = cast<isize>(count);
    isize i = 0;
    while (i < want) {
        into.add(item: 0ui8);
        i = i + 1;
    }
    isize got = 0;
    while (got < want) {
        isize n = 0 - 1;
        borrow into.viewMut() as all {
            Result<isize, IoError> r = f.read(into: all.slice(from: got, count: want - got));
            n = match (r) { case Ok(value: x): x; case Err(error: e): 0 - 1; };
        }
        if (n < 0) { return "${path}: the read failed"; }
        if (n == 0) { break; }
        got = got + n;
    }
    while (into.length() > got) { Optional<uint8> dropped = into.pop(); }
    return "";
}

// The native leg's files (host.kama): every list, read and save request one context holds, and the events they raise
// — kept apart from RmlUi's, and delivered after the document's own. Parallel columns, one row per handle.
type resource FileStore {
    int32 next;
    DynamicArray<int32> handles;
    DynamicArray<int32> kinds;                    // FILE_LIST, FILE_READ, FILE_SAVE
    DynamicArray<DynamicArray<string>> paths;     // a list's files
    DynamicArray<DynamicArray<int64>> sizes;      // … and their sizes, read when they were listed
    DynamicArray<string> texts;                   // a chooser's `accept`, a read's error, a save's name
    DynamicArray<int32> flags;                    // a chooser's CHOSEN_*; a save's 1 once taken
    DynamicArray<DynamicArray<uint8>> bytes;      // a read's or a save's
    DynamicArray<UiEvent> queue;                  // the files' events, waiting for `pollEvent`
    DynamicArray<int32> listening;                // the bindings `bindElement` made listen: what hears a file drop
    int32 chooser;                                // the list a chooser waits to fill, 0 for none

    public ctor make()
    {
        this.next = 1;
        this.handles = DynamicArray.empty();
        this.kinds = DynamicArray.empty();
        this.paths = DynamicArray.empty();
        this.sizes = DynamicArray.empty();
        this.texts = DynamicArray.empty();
        this.flags = DynamicArray.empty();
        this.bytes = DynamicArray.empty();
        this.queue = DynamicArray.empty();
        this.listening = DynamicArray.empty();
        this.chooser = 0;
    }

    fn isize rowOf(int32 handle, int32 kind)
    {
        isize i = 0;
        while (i < this.handles.length()) {
            if (this.handles[i] == handle) {
                if (this.kinds[i] == kind) { return i; }
                return 0 - 1;
            }
            i = i + 1;
        }
        return 0 - 1;
    }

    fn int32 add(int32 kind)
    {
        int32 h = this.next;
        this.next = this.next + 1;
        this.handles.add(item: h);
        this.kinds.add(item: kind);
        this.paths.add(item: DynamicArray.empty());
        this.sizes.add(item: DynamicArray.empty());
        this.texts.add(item: "");
        this.flags.add(item: 0);
        this.bytes.add(item: DynamicArray.empty());
        return h;
    }

    fn void forget(isize row)
    {
        int32 h = this.handles.remove(index: row);
        int32 k = this.kinds.remove(index: row);
        DynamicArray<string> p = this.paths.remove(index: row);
        DynamicArray<int64> z = this.sizes.remove(index: row);
        string t = this.texts.remove(index: row);
        int32 f = this.flags.remove(index: row);
        DynamicArray<uint8> b = this.bytes.remove(index: row);
    }

    unsafe fn void fill(isize row, const ref DynamicArray<string> paths)
    {
        isize i = 0;
        while (i < paths.length()) {
            this.paths[row].add(item: copy paths[i]);
            this.sizes[row].add(item: sizeOf(path: paths[i]));
            i = i + 1;
        }
    }

    // A list of these files (their sizes read now).
    public unsafe fn int32 list(const ref DynamicArray<string> paths)
    {
        int32 h = this.add(kind: FILE_LIST);
        this.fill(row: this.rowOf(handle: h, kind: FILE_LIST), paths: paths);
        return h;
    }

    // ---- the chooser ----

    public fn int32 choose(const ref string accept, bool multiple)
    {
        if (this.chooser != 0) { return 0; }
        int32 h = this.add(kind: FILE_LIST);
        isize row = this.rowOf(handle: h, kind: FILE_LIST);
        this.texts[row] = copy accept;
        int32 f = CHOSEN_ASKED | CHOSEN_OPEN;
        if (multiple) { f = f | CHOSEN_MANY; }
        this.flags[row] = f;
        this.chooser = h;
        return h;
    }

    public fn int32 takeRequest()
    {
        isize i = 0;
        while (i < this.handles.length()) {
            if (this.kinds[i] == FILE_LIST && (this.flags[i] & CHOSEN_ASKED) != 0) {
                this.flags[i] = this.flags[i] & ~CHOSEN_ASKED;
                return this.handles[i];
            }
            i = i + 1;
        }
        return 0;
    }

    public fn string accept(int32 files)
    {
        isize row = this.rowOf(handle: files, kind: FILE_LIST);
        if (row < 0) { return ""; }
        return copy this.texts[row];
    }

    public fn bool multiple(int32 files)
    {
        isize row = this.rowOf(handle: files, kind: FILE_LIST);
        return row >= 0 && (this.flags[row] & CHOSEN_MANY) != 0;
    }

    // The answer: the paths chosen (none: cancelled; only the first when it takes one), then the `Files` event. Once.
    public unsafe fn void provide(int32 files, const ref DynamicArray<string> paths)
    {
        isize row = this.rowOf(handle: files, kind: FILE_LIST);
        if (row < 0 || (this.flags[row] & CHOSEN_OPEN) == 0) { return; }
        DynamicArray<string> chosen = DynamicArray.empty();
        isize i = 0;
        while (i < paths.length() && (i == 0 || (this.flags[row] & CHOSEN_MANY) != 0)) {
            chosen.add(item: copy paths[i]);
            i = i + 1;
        }
        this.fill(row: row, paths: chosen);
        this.flags[row] = this.flags[row] & CHOSEN_MANY;
        if (this.chooser == files) { this.chooser = 0; }
        this.queue.add(item: UiEvent.make(kind: UiEventKind::Files, element: 0, target: 0, source: 0, key: 0, mods: 0,
                                          files: files, atX: 0.0, atY: 0.0));
    }

    // ---- a list ----

    public fn int32 count(int32 files)
    {
        isize row = this.rowOf(handle: files, kind: FILE_LIST);
        if (row < 0) { return 0; }
        return cast<int32>(this.paths[row].length());
    }

    public fn string path(int32 files, int32 index)
    {
        isize row = this.rowOf(handle: files, kind: FILE_LIST);
        isize i = cast<isize>(index);
        if (row < 0 || i < 0 || i >= this.paths[row].length()) { return ""; }
        return copy this.paths[row][i];
    }

    public fn int64 size(int32 files, int32 index)
    {
        isize row = this.rowOf(handle: files, kind: FILE_LIST);
        isize i = cast<isize>(index);
        if (row < 0 || i < 0 || i >= this.sizes[row].length()) { return -1; }
        return this.sizes[row][i];
    }

    // A released chooser that is still open frees the program to ask again; its late answer is ignored.
    public fn void release(int32 files)
    {
        isize row = this.rowOf(handle: files, kind: FILE_LIST);
        if (row < 0) { return; }
        if (this.chooser == files) { this.chooser = 0; }
        this.forget(row: row);
    }

    // ---- a read: done at once, natively, and reported at the next poll as the web's is ----

    public unsafe fn int32 read(int32 files, int32 index, int64 offset, int32 count)
    {
        string p = this.path(files: files, index: index);
        if (p.isEmpty() || offset < 0 || count < 0) { return 0; }
        int32 r = this.add(kind: FILE_READ);
        isize row = this.rowOf(handle: r, kind: FILE_READ);
        DynamicArray<uint8> got = DynamicArray.empty();
        string why = readSlice(path: p, offset: offset, count: count, into: got);
        this.bytes[row] = give got;
        this.texts[row] = give why;
        this.queue.add(item: UiEvent.make(kind: UiEventKind::Read, element: 0, target: 0, source: 0, key: 0, mods: 0,
                                          files: r, atX: 0.0, atY: 0.0));
        return r;
    }

    public fn bool takeRead(int32 read, ref DynamicArray<uint8> into)
    {
        into.clear();
        isize row = this.rowOf(handle: read, kind: FILE_READ);
        if (row < 0) { return false; }
        bool ok = this.texts[row].isEmpty();
        if (ok) {
            DynamicArray<uint8> none = DynamicArray.empty();
            DynamicArray<uint8> got = replace(place: ref this.bytes[row], with: give none);
            into = give got;
        }
        this.forget(row: row);
        return ok;
    }

    public fn string readError(int32 read)
    {
        isize row = this.rowOf(handle: read, kind: FILE_READ);
        if (row < 0) { return ""; }
        return copy this.texts[row];
    }

    // ---- a save: held until the program takes it ----

    public fn void save(const ref string name, ConstView<uint8> bytes)
    {
        int32 h = this.add(kind: FILE_SAVE);
        isize row = this.rowOf(handle: h, kind: FILE_SAVE);
        this.texts[row] = copy name;
        isize i = 0;
        while (i < bytes.length()) {
            this.bytes[row].add(item: bytes[i]);
            i = i + 1;
        }
    }

    public fn int32 takeSave()
    {
        isize i = 0;
        while (i < this.handles.length()) {
            if (this.kinds[i] == FILE_SAVE && this.flags[i] == 0) {
                this.flags[i] = 1;
                return this.handles[i];
            }
            i = i + 1;
        }
        return 0;
    }

    public fn string saveName(int32 save)
    {
        isize row = this.rowOf(handle: save, kind: FILE_SAVE);
        if (row < 0) { return ""; }
        return copy this.texts[row];
    }

    public fn bool takeSaveBytes(int32 save, ref DynamicArray<uint8> into)
    {
        into.clear();
        isize row = this.rowOf(handle: save, kind: FILE_SAVE);
        if (row < 0) { return false; }
        DynamicArray<uint8> none = DynamicArray.empty();
        DynamicArray<uint8> got = replace(place: ref this.bytes[row], with: give none);
        into = give got;
        this.forget(row: row);
        return true;
    }

    // ---- the events, and what hears a file drop ----

    public fn void post(UiEvent ev) { this.queue.add(item: ev); }

    public fn Optional<UiEvent> poll()
    {
        if (this.queue.length() == 0) { return Optional::None; }
        UiEvent ev = this.queue.remove(index: 0);
        return Optional::Some(value: ev);
    }

    // A new document: its drops and pastes go with it, a chooser's answer and a read's end stay (they answer the
    // program), and no binding of the old one listens any more.
    public fn void documentGone()
    {
        DynamicArray<UiEvent> kept = DynamicArray.empty();
        isize i = 0;
        while (i < this.queue.length()) {
            bool keep = match (this.queue[i].kind) { case Files: true; case Read: true; case _: false; };
            if (keep) { kept.add(item: this.queue[i]); }
            i = i + 1;
        }
        this.queue = give kept;
        this.listening.clear();
    }

    public fn void listen(int32 binding)
    {
        if (!this.listening.contains(item: binding)) { this.listening.add(item: binding); }
    }

    public fn bool listens(int32 binding) { return this.listening.contains(item: binding); }
}

// UI_KEY_* (GLFW's numbers) -> RmlUi's KeyIdentifier, or 0 for a key outside types.kama's table — which is DROPPED.
// The letters, digits and function keys are runs in both numberings, so they map by offset.
fn int32 rmlKey(int32 code)
{
    if (code >= UI_KEY_A && code <= UI_KEY_Z) { return KEY_A + (code - UI_KEY_A); }
    if (code >= UI_KEY_0 && code <= UI_KEY_9) { return KEY_0 + (code - UI_KEY_0); }
    if (code >= UI_KEY_F1 && code <= UI_KEY_F12) { return KEY_F1 + (code - UI_KEY_F1); }
    if (code == UI_KEY_ESCAPE) { return KEY_ESCAPE; }
    if (code == UI_KEY_ENTER) { return KEY_RETURN; }
    if (code == UI_KEY_TAB) { return KEY_TAB; }
    if (code == UI_KEY_RIGHT) { return KEY_RIGHT; }
    if (code == UI_KEY_LEFT) { return KEY_LEFT; }
    if (code == UI_KEY_DOWN) { return KEY_DOWN; }
    if (code == UI_KEY_UP) { return KEY_UP; }
    if (code == UI_KEY_PAGE_UP) { return KEY_PAGE_UP; }
    if (code == UI_KEY_PAGE_DOWN) { return KEY_PAGE_DOWN; }
    // The caret's keys, for a focused text field. Inert on a button.
    if (code == UI_KEY_BACKSPACE) { return KEY_BACKSPACE; }
    if (code == UI_KEY_DELETE) { return KEY_DELETE; }
    if (code == UI_KEY_HOME) { return KEY_HOME; }
    if (code == UI_KEY_END) { return KEY_END; }
    return 0;
}

// The way back, for a `Key` event: RmlUi's KeyIdentifier -> UI_KEY_*, 0 outside the table.
fn int32 uiKey(int32 k)
{
    if (k >= KEY_A && k <= KEY_Z) { return UI_KEY_A + (k - KEY_A); }
    if (k >= KEY_0 && k <= KEY_9) { return UI_KEY_0 + (k - KEY_0); }
    if (k >= KEY_F1 && k <= KEY_F12) { return UI_KEY_F1 + (k - KEY_F1); }
    if (k == KEY_ESCAPE) { return UI_KEY_ESCAPE; }
    if (k == KEY_RETURN || k == KEY_NUMPAD_ENTER) { return UI_KEY_ENTER; }
    if (k == KEY_TAB) { return UI_KEY_TAB; }
    if (k == KEY_RIGHT) { return UI_KEY_RIGHT; }
    if (k == KEY_LEFT) { return UI_KEY_LEFT; }
    if (k == KEY_DOWN) { return UI_KEY_DOWN; }
    if (k == KEY_UP) { return UI_KEY_UP; }
    if (k == KEY_PAGE_UP) { return UI_KEY_PAGE_UP; }
    if (k == KEY_PAGE_DOWN) { return UI_KEY_PAGE_DOWN; }
    if (k == KEY_BACKSPACE) { return UI_KEY_BACKSPACE; }
    if (k == KEY_DELETE) { return UI_KEY_DELETE; }
    if (k == KEY_HOME) { return UI_KEY_HOME; }
    if (k == KEY_END) { return UI_KEY_END; }
    return 0;
}

// UI_MOD_* (GLFW's bits) <-> RmlUi's MOD_*. Cmd (RmlUi's META) folds into CTRL on the way out, as types.kama says.
fn int32 rmlMods(int32 mods)
{
    int32 m = MOD_NONE;
    if ((mods & UI_MOD_SHIFT) != 0) { m = m | MOD_SHIFT; }
    if ((mods & UI_MOD_CTRL) != 0) { m = m | MOD_CTRL; }
    if ((mods & UI_MOD_ALT) != 0) { m = m | MOD_ALT; }
    return m;
}

fn int32 uiMods(int32 m)
{
    int32 mods = 0;
    if ((m & MOD_SHIFT) != 0) { mods = mods | UI_MOD_SHIFT; }
    if ((m & (MOD_CTRL | MOD_META)) != 0) { mods = mods | UI_MOD_CTRL; }
    if ((m & MOD_ALT) != 0) { mods = mods | UI_MOD_ALT; }
    return mods;
}

// Which keys become a `Key` event (types.kama): every key of the table that types no character — they are all
// numbered from 256 — and a letter or a digit only as a shortcut, with Ctrl or Alt held.
fn bool reported(int32 key, int32 mods)
{
    if (key == 0) { return false; }
    if (key >= UI_KEY_ESCAPE) { return true; }
    return (mods & (UI_MOD_CTRL | UI_MOD_ALT)) != 0;
}

// A `class` attribute with `name` switched: every occurrence dropped, then added once at the end when `on`.
fn string toggled(const ref string list, const ref string name, bool on)
{
    string result = "";
    foreach (string piece in list.split(separator: " ")) {
        if (!piece.isEmpty() && piece != name) {
            if (result.isEmpty()) { result = copy piece; } else { result = "${result} ${piece}"; }
        }
    }
    if (on) {
        if (result.isEmpty()) { result = copy name; } else { result = "${result} ${name}"; }
    }
    return result;
}

// Where the tooltip goes from the pointer, in pixels (host.kama; kama_ui_web.js carries the same two numbers).
comptime int32 TIP_LEFT = 12;
comptime int32 TIP_TOP = 16;

// ⚠️ A CLASS IS WRITTEN THROUGH THE `class` ATTRIBUTE (0.2.2), as a browser's `classList` writes it: RmlUi keeps a class
// `setClass` toggled BESIDE the attributes, where serializing the element (`innerRml`) does not see it. RmlUi turns the
// attribute into the class list itself.
//
// ⚠️ AND AN `<input>` GETS ITS TYPE BACK (CHANGED in 0.4.0). RmlUi gives an input its type as a class of its own —
// `range`, `checkbox`, `text`… (ElementFormControlInput), beside the attribute — and a write of the attribute replaces
// the whole class list, so a document's `input.range` rule stopped matching the moment a class was toggled on the
// slider: a drag passing over one, or `setElementClass` on it, made it the size of a text field. It is set again here.
unsafe fn void classOn(Element el, const ref string name, bool on)
{
    string attr = "class";
    Optional<string> current = el.attribute(name: attr);
    string list = match (current) { case None: ""; case Some(value: s): copy s; };
    string next = toggled(list: list, name: name, on: on);
    if (next == list) { return; }
    el.setAttributeQuietly(name: attr, value: next);
    if (el.tag() == "input") {
        string own = inputClass(el: el);
        el.setClass(name: own, on: true);
    }
}

// The class RmlUi gives an `<input>` of its own: its type, where RmlUi knows the type, else `text`.
unsafe fn string inputClass(Element el)
{
    Optional<string> t = el.attribute(name: "type");
    string type = match (t) { case None: "text"; case Some(value: s): copy s; };
    if (type == "password" || type == "radio" || type == "checkbox" || type == "range" || type == "submit" ||
        type == "button") { return type; }
    return "text";
}

// A form control: what has a value of its own (`elementText`), not text content.
unsafe fn bool isControl(Element el)
{
    string tag = el.tag();
    return tag == "input" || tag == "textarea" || tag == "select";
}

// What reports Focus and Blur (host.kama): a button, a form control, or an element with a tab index — what a browser
// focuses. ⚠️ RmlUi focuses WHATEVER IS PRESSED (every element's `focus` is `auto`), and sends Focus to each element
// joining the focus chain; reporting those would give a click on a row a Focus the web never has.
unsafe fn bool focusable(Element el)
{
    string tag = el.tag();
    if (tag == "button" || tag == "input" || tag == "textarea" || tag == "select") { return true; }
    Optional<string> index = el.attribute(name: "tabindex");
    match (index) { case Some(value: s): { if (s != "-1") { return true; } } case None: { } };
    Optional<string> rcss = el.property(name: "tab-index");
    return match (rcss) { case None: false; case Some(value: s): s == "auto"; };
}

// The tooltip's owner: the nearest element at or above `el` with a non-empty `title`; a dead element when none has one.
unsafe fn Element titledOf(Element el)
{
    Element at = el;
    while (at.isLive()) {
        Optional<string> t = at.attribute(name: "title");
        bool titled = match (t) { case None: false; case Some(value: s): !s.isEmpty(); };
        if (titled) { return at; }
        Optional<Element> up = at.parent();
        match (up) { case None: { return Element.fromHandle(handle: 0); } case Some(value: p): { at = p; } };
    }
    return Element.fromHandle(handle: 0);
}

unsafe fn string titleOf(Element el)
{
    Optional<string> t = el.attribute(name: "title");
    return match (t) { case None: ""; case Some(value: s): copy s; };
}

fn bool navKey(int32 code)
{
    return code == UI_KEY_TAB || code == UI_KEY_UP || code == UI_KEY_DOWN || code == UI_KEY_LEFT || code == UI_KEY_RIGHT;
}

fn UiCommandKind kindOf(CommandKind k)
{
    return match (k) {
        case Draw:           UiCommandKind::Draw;
        case ClipEnable:     UiCommandKind::ClipEnable;
        case ClipDisable:    UiCommandKind::ClipDisable;
        case ClipSet:        UiCommandKind::ClipSet;
        case ClipSetInverse: UiCommandKind::ClipSetInverse;
        case ClipIntersect:  UiCommandKind::ClipIntersect;
    };
}

// The document, and the tooltip's state, are fields: what one document needs, on the value that loaded it. Keep ONE
// UiContext and pass it by `ref` (a copy taken before a load does not see the new document — as since 0.1.0).
type value UiContext implements UiHost {
    int32 ready;
    RmlUi lib;
    Context ctx;
    Document doc;
    Element tip;            // the package's tooltip element in `doc` (host.kama)
    int32 tipOwner;         // the element whose title it is for (an element handle), 0 for none
    float64 tipSince;       // when that element began to be hovered, on `lib`'s clock
    bool tipShown;
    bool tipQuiet;          // dismissed (a press, a scroll) until another element is hovered
    float32 pointerX;       // the pointer, from `mouseMove`: where the tooltip goes
    float32 pointerY;
    bool scrollMarked;      // a `scrollToEnd` or `scrollIntoView` waits for the next update (`followEnds`)
    // (0.4.0) The files (host.kama), on the heap: made in `start` and released here as an `Owned` hands a value to a
    // foreign owner (std::memory), borrowed in place through `store[0]`, and taken back and dropped in `close`. null
    // while the UI has not started.
    UnsafePtr<FileStore> store;

    // Start RmlUi, make a context `width` x `height` framebuffer pixels, and load `fontPath` ("" for none yet) as the
    // first face. A UI that will not start leaves `isOpen()` false, and every method then does nothing.
    public unsafe ctor open(int32 width, int32 height, const ref string fontPath)
    {
        this.ready = 0;
        this.lib = RmlUi.none();
        this.ctx = Context.fromHandle(handle: 0);
        this.doc = Document.fromHandle(handle: 0);
        this.tip = Element.fromHandle(handle: 0);
        this.tipOwner = 0;
        this.tipSince = 0.0;
        this.tipShown = false;
        this.tipQuiet = false;
        this.pointerX = 0.0;
        this.pointerY = 0.0;
        this.scrollMarked = false;
        this.store = null;
        this.start(width: width, height: height, fontPath: fontPath);
    }

    // ADDED (0.2.0): a PAGE (host.kama). Natively it starts exactly as `open` does — `width` x `height` is the window's
    // framebuffer — because RmlUi lays a document out in whatever box it is given; what differs is the program's half:
    // `setSize` on every window resize, and the commands drawn at the window's origin with no letterbox.
    public unsafe ctor openPage(int32 width, int32 height, const ref string fontPath)
    {
        this.ready = 0;
        this.lib = RmlUi.none();
        this.ctx = Context.fromHandle(handle: 0);
        this.doc = Document.fromHandle(handle: 0);
        this.tip = Element.fromHandle(handle: 0);
        this.tipOwner = 0;
        this.tipSince = 0.0;
        this.tipShown = false;
        this.tipQuiet = false;
        this.pointerX = 0.0;
        this.pointerY = 0.0;
        this.scrollMarked = false;
        this.store = null;
        this.start(width: width, height: height, fontPath: fontPath);
    }

    unsafe fn void start(int32 width, int32 height, const ref string fontPath)
    {
        Result<RmlUi, RmlUiError> started = RmlUi.start();
        match (started) {
            case Err(error: e): { }
            case Ok(value: u): {
                this.lib = u;
                string name = "";
                Result<Context, RmlUiError> made = Context.create(ui: u, name: name, width: width, height: height);
                match (made) {
                    case Err(error: e): { this.lib.shutdown(); }
                    case Ok(value: c): {
                        this.ctx = c;
                        this.ready = 1;
                        Owned<FileStore> files = new FileStore.make();
                        this.store = files.release();
                        if (!fontPath.isEmpty()) { this.lib.loadFontFace(path: fontPath, fallback: false); }
                    }
                };
            }
        };
    }

    public fn bool isOpen() { return this.ready != 0; }

    public unsafe fn void loadFont(const ref string path, bool fallback)
    {
        if (this.ready == 0) { return; }
        this.lib.loadFontFace(path: path, fallback: fallback);
    }

    public unsafe fn void provideImage(const ref string name, ConstView<uint8> rgba, int32 width, int32 height)
    {
        if (this.ready == 0) { return; }
        this.lib.provideImage(name: name, rgba: rgba, width: width, height: height);
    }

    public unsafe fn void setImageRewrite(const ref string nativeExt, const ref string webExt) { }

    // ⚠️ ONE DOCUMENT AT A TIME: the previous one is closed here, because RmlUi renders every SHOWN document in a
    // context, so two loads without a close would draw one screen over the other. Its events go with it — a queued
    // click names an element that is going.
    unsafe fn void closeCurrent()
    {
        if (this.doc.isLive()) { this.doc.close(); }
        this.doc = Document.fromHandle(handle: 0);
        this.ctx.clearEvents();
        this.tip = Element.fromHandle(handle: 0);
        this.tipOwner = 0;
        this.tipShown = false;
        this.tipQuiet = false;
        this.scrollMarked = false;
        this.store[0].documentGone();
    }

    public unsafe fn bool loadDocument(const ref string path)
    {
        if (this.ready == 0) { return false; }
        this.closeCurrent();
        Optional<Document> d = this.ctx.loadDocument(path: path);
        return this.adopt(d: d);
    }

    public unsafe fn bool loadDocumentText(const ref string rml)
    {
        if (this.ready == 0) { return false; }
        this.closeCurrent();
        string url = "[ui document]";
        Optional<Document> d = this.ctx.loadDocumentRml(rml: rml, sourceUrl: url);
        return this.adopt(d: d);
    }

    // A loaded document, made the package's: its draggable elements dressed, the package's own listeners on its root
    // (`own` reads what they hear), and the tooltip element appended. Then shown.
    unsafe fn bool adopt(Optional<Document> d)
    {
        match (d) {
            case None: { return false; }
            case Some(value: loaded): { this.doc = loaded; }
        };
        Element root = this.doc.root();
        this.dress(el: root);
        string keydown = "keydown";
        string scroll = "scroll";
        string dragstart = "dragstart";
        string dragover = "dragover";
        string dragout = "dragout";
        string dragend = "dragend";
        // Capture: a key reaches its target's listeners after the root's, and a text field may stop it there.
        Optional<Listener> l1 = root.listen(event: keydown, flags: LISTEN_CAPTURE);
        Optional<Listener> l2 = root.listen(event: scroll, flags: LISTEN_CAPTURE);
        Optional<Listener> l3 = root.listen(event: dragstart, flags: LISTEN_BUBBLE);
        Optional<Listener> l4 = root.listen(event: dragover, flags: LISTEN_BUBBLE);
        Optional<Listener> l5 = root.listen(event: dragout, flags: LISTEN_BUBBLE);
        Optional<Listener> l6 = root.listen(event: dragend, flags: LISTEN_BUBBLE);
        this.makeTip();
        this.doc.show(modal: Modal::None, focus: Focus::Auto);
        return true;
    }

    // The tooltip element, appended to the document's root: absolute, hidden, and transparent to the pointer, so it
    // never takes the hover from what it describes. The document styles `.ui-tooltip`.
    unsafe fn void makeTip()
    {
        Element root = this.doc.root();
        string markup = "<div id='kama-ui-tooltip' class='ui-tooltip' style='position: absolute; pointer-events: none; display: none; z-index: 1000;'></div>";
        int32 added = root.appendRml(rml: markup);
        string id = "kama-ui-tooltip";
        Optional<Element> t = this.doc.byId(id: id);
        this.tip = match (t) { case None: Element.fromHandle(handle: 0); case Some(value: e): e; };
        this.tipOwner = 0;
        this.tipShown = false;
        this.tipQuiet = false;
    }

    // `draggable="true"` is the package's one drag markup (host.kama): RmlUi drags what its RCSS `drag` says, so each
    // such element under `el` gets the inline property. Run over whatever markup is inserted.
    unsafe fn void dress(Element el)
    {
        Optional<string> d = el.attribute(name: "draggable");
        bool drags = match (d) { case None: false; case Some(value: s): s == "true"; };
        if (drags) { el.setProperty(name: "drag", value: "drag-drop"); }
        int32 n = el.childCount();
        int32 i = 0;
        while (i < n) {
            Optional<Element> c = el.child(index: i);
            match (c) { case None: { } case Some(value: child): { this.dress(el: child); } };
            i = i + 1;
        }
    }

    // The element a handle names now, re-found after a rewrite (a binding's job), or None.
    unsafe fn Optional<Element> bound(int32 handle)
    {
        if (this.ready == 0 || handle == 0) { return Optional::None; }
        Binding b = Binding.fromHandle(handle: handle);
        return b.element();
    }

    // ⚠️ THE RELEASE host.kama promises is @kama/rmlui's, and nothing here has to do it: RmlUi destroys the old children,
    // their listeners retire themselves as they go, and a binding tracks its element through an observer — so a handle
    // into what was replaced reads as dead (every call a no-op) rather than reaching freed memory, until its id is
    // found again. The suite proves it under AddressSanitizer.
    public unsafe fn void setInnerRml(int32 handle, const ref string rml)
    {
        Optional<Element> e = this.bound(handle: handle);
        match (e) { case Some(value: el): { el.setInnerRml(rml: rml); this.dress(el: el); } case None: { } };
    }

    public unsafe fn void setSize(int32 width, int32 height)
    {
        if (this.ready == 0) { return; }
        this.ctx.setDimensions(width: width, height: height);
    }

    // ⚠️ A NO-OP, AND DELIBERATELY NOT WIRED TO ANYTHING: the renderer draws the recorded geometry under its own
    // letterbox transform, so feeding the same offsets here would apply them twice. It exists because a backend that
    // owns real elements has no other way to be told it is off screen.
    public unsafe fn void setViewport(float32 offsetX, float32 offsetY, float32 scale, bool visible) { }

    public unsafe fn void update()
    {
        if (this.ready == 0) { return; }
        float64 now = this.lib.time();
        this.lib.setTime(seconds: now + 1.0 / 60.0);
        this.ctx.update();
        this.followEnds();
        this.tooltips();
    }

    public unsafe fn void updateAt(float64 seconds)
    {
        if (this.ready == 0) { return; }
        this.lib.setTime(seconds: seconds);
        this.ctx.update();
        this.followEnds();
        this.tooltips();
    }

    // The tooltip (host.kama), from the hover RmlUi keeps and the clock `update` just moved. The owner is the nearest
    // element at or above the hovered one with a non-empty `title`; a new owner restarts the delay and hides what was
    // shown. Recreated if a rewrite of the root took it.
    unsafe fn void tooltips()
    {
        if (!this.doc.isLive()) { return; }
        if (!this.tip.isLive()) { this.makeTip(); }
        Optional<Element> hover = this.ctx.hoverElement();
        Element titled = match (hover) { case None: Element.fromHandle(handle: 0); case Some(value: h): titledOf(el: h); };
        int32 owner = titled.handle();
        float64 now = this.lib.time();
        if (owner != this.tipOwner) {
            this.hideTip();
            this.tipOwner = owner;
            this.tipSince = now;
            this.tipQuiet = false;
            return;
        }
        if (owner == 0 || this.tipShown || this.tipQuiet) { return; }
        if (now - this.tipSince < UI_TOOLTIP_DELAY) { return; }
        string title = titleOf(el: titled);
        this.tip.setText(text: title);
        float32 left = this.pointerX + cast<float32>(TIP_LEFT);
        float32 top = this.pointerY + cast<float32>(TIP_TOP);
        this.tip.setProperty(name: "left", value: "${left}px");
        this.tip.setProperty(name: "top", value: "${top}px");
        this.tip.setProperty(name: "display", value: "block");
        this.tipShown = true;
    }

    // Hidden, and emptied: a hidden tooltip has no text, on both legs, which is what `elementContent` reads.
    unsafe fn void hideTip()
    {
        if (this.tipShown && this.tip.isLive()) {
            this.tip.setProperty(name: "display", value: "none");
            string none = "";
            this.tip.setText(text: none);
        }
        this.tipShown = false;
    }

    // A press or a scroll: hidden, and kept hidden while the same element is hovered.
    unsafe fn void dismissTip()
    {
        this.hideTip();
        this.tipQuiet = true;
    }

    // `scrollToEnd` and `scrollIntoView` (host.kama) mark; this honours the marks, AFTER the layout pass. ⚠️ NOT AT THE CALL: RmlUi measures
    // only in `update`, so `scrollHeight` at the call would be the last layout's — without the line just written — and a
    // log would follow one line behind. The mark is an attribute written quietly: state on RmlUi's side of the seam, as
    // everything a `value` context must remember is. The scroll this makes raises RmlUi's `scroll` event, which no
    // binding listens for, so nothing reaches `pollEvent`.
    // ⚠️ ONLY WHEN SOMETHING IS MARKED: a query walks the whole document, and a log of thousands of lines would pay
    // for it every frame.
    unsafe fn void followEnds()
    {
        if (!this.scrollMarked || !this.doc.isLive()) { return; }
        this.scrollMarked = false;
        Element root = this.doc.root();
        string marked = "[data-kama-ui-end]";
        string mark = "data-kama-ui-end";
        int32 left = 4096;   // more marks than a document has elements cannot happen; a bound, not a budget
        bool more = true;
        while (more && left > 0) {
            Optional<Element> e = root.query(selector: marked);
            match (e) {
                case None: { more = false; }
                case Some(value: el): {
                    el.removeAttributeQuietly(name: mark);
                    el.setScrollTop(top: el.scrollHeight());
                }
            };
            left = left - 1;
        }
        string intoMarked = "[data-kama-ui-into-view]";
        string into = "data-kama-ui-into-view";
        more = true;
        while (more && left > 0) {
            Optional<Element> e = root.query(selector: intoMarked);
            match (e) {
                case None: { more = false; }
                case Some(value: el): {
                    el.removeAttributeQuietly(name: into);
                    el.scrollIntoView();
                }
            };
            left = left - 1;
        }
    }

    public unsafe fn void scrollIntoView(int32 handle)
    {
        Optional<Element> e = this.bound(handle: handle);
        string mark = "data-kama-ui-into-view";
        string on = "";
        match (e) { case Some(value: el): { el.setAttributeQuietly(name: mark, value: on); this.scrollMarked = true; } case None: { } };
    }

    // @kama/rmlui 0.2.0's `appendRml`: only the new markup is parsed, and the children already there — their handles,
    // listeners and bindings, the scroll offset — are not touched. The new children are dressed for dragging.
    public unsafe fn void appendInnerRml(int32 handle, const ref string rml)
    {
        Optional<Element> e = this.bound(handle: handle);
        match (e) {
            case None: { }
            case Some(value: el): {
                int32 before = el.childCount();
                int32 added = el.appendRml(rml: rml);
                int32 i = before;
                while (i < before + added) {
                    Optional<Element> c = el.child(index: i);
                    match (c) { case None: { } case Some(value: child): { this.dress(el: child); } };
                    i = i + 1;
                }
            }
        };
    }

    public unsafe fn int32 childCount(int32 handle)
    {
        Optional<Element> e = this.bound(handle: handle);
        return match (e) { case None: 0; case Some(value: el): el.childCount(); };
    }

    public unsafe fn int32 removeChildren(int32 handle, int32 from, int32 count)
    {
        Optional<Element> e = this.bound(handle: handle);
        return match (e) { case None: 0; case Some(value: el): el.removeChildren(from: from, count: count); };
    }

    public unsafe fn string elementContent(int32 handle)
    {
        Optional<Element> e = this.bound(handle: handle);
        return match (e) {
            case None: "";
            case Some(value: el): {
                if (isControl(el: el)) { return ""; }
                := el.text();
            }
        };
    }

    // `Element.setText` escapes as it writes: the text is never parsed.
    public unsafe fn void setElementContent(int32 handle, const ref string text)
    {
        Optional<Element> e = this.bound(handle: handle);
        match (e) {
            case None: { }
            case Some(value: el): { if (!isControl(el: el)) { el.setText(text: text); } }
        };
    }

    // From the last layout, as every size natively is — or true while a `scrollToEnd` waits for the next update, so a
    // program that appended and asked in one frame still reads "at the end" before that update.
    public unsafe fn bool isScrolledToEnd(int32 handle)
    {
        Optional<Element> e = this.bound(handle: handle);
        Element el = Element.fromHandle(handle: 0);
        match (e) { case None: { return false; } case Some(value: x): { el = x; } };
        Optional<string> pending = el.attribute(name: "data-kama-ui-end");
        bool waiting = match (pending) { case None: false; case Some(value: s): true; };
        if (waiting) { return true; }
        return el.scrollHeight() - el.scrollTop() - el.clientHeight() <= 1.0;
    }

    public unsafe fn void scrollToEnd(int32 handle)
    {
        Optional<Element> e = this.bound(handle: handle);
        string mark = "data-kama-ui-end";
        string on = "";
        match (e) { case Some(value: el): { el.setAttributeQuietly(name: mark, value: on); this.scrollMarked = true; } case None: { } };
    }

    public unsafe fn void render()
    {
        if (this.ready == 0) { return; }
        this.ctx.render();
    }

    public unsafe fn int32 commandCount()
    {
        if (this.ready == 0) { return 0; }
        return this.ctx.commandCount();
    }

    public unsafe fn UiCommand command(int32 index)
    {
        UiCommand u = UiCommand.empty();
        if (this.ready == 0) { return u; }
        Command c = this.ctx.command(index: index);
        u.kind = kindOf(k: c.kind);
        u.vertices = c.vertices;
        u.vertexCount = c.vertexCount;
        u.indices = c.indices;
        u.indexCount = c.indexCount;
        u.texture = c.texture;
        u.translateX = c.translateX;
        u.translateY = c.translateY;
        u.scissorEnabled = c.scissorEnabled;
        u.scissorX = c.scissorX;
        u.scissorY = c.scissorY;
        u.scissorWidth = c.scissorWidth;
        u.scissorHeight = c.scissorHeight;
        u.transformed = c.transformed;
        u.transform = c.transform;
        return u;
    }

    public unsafe fn int32 textureCount()
    {
        if (this.ready == 0) { return 0; }
        return this.lib.textureCount();
    }

    public unsafe fn UiTexture texture(int32 handle)
    {
        if (this.ready == 0) { return UiTexture.empty(); }
        Texture t = this.lib.texture(handle: handle);
        return UiTexture.make(pixels: t.pixels, width: t.width, height: t.height);
    }

    public unsafe fn int32 textureGeneration(int32 handle)
    {
        if (this.ready == 0) { return 0; }
        Texture t = this.lib.texture(handle: handle);
        return t.generation;
    }

    public unsafe fn void mouseMove(float32 x, float32 y)
    {
        if (this.ready == 0) { return; }
        this.pointerX = x;
        this.pointerY = y;
        this.ctx.mouseMove(x: x, y: y, mods: MOD_NONE);
    }

    public unsafe fn void mouseButton(int32 button, bool down, int32 mods)
    {
        if (this.ready == 0) { return; }
        if (down) { this.dismissTip(); }
        this.ctx.mouseButton(button: button, down: down, mods: rmlMods(mods: mods));
    }

    public unsafe fn void mouseWheel(float32 delta)
    {
        if (this.ready == 0) { return; }
        this.dismissTip();
        this.ctx.mouseWheel(dx: 0.0, dy: delta, mods: MOD_NONE);
    }

    // ⚠️ THE KEY GOES TO RMLUI FIRST, ALWAYS (CHANGED in 0.3.0; the first-press rule below used to return before it):
    // that is how the document hears it — a `Key` event — on the press that also lands the ring.
    public unsafe fn void key(int32 code, bool down, int32 mods)
    {
        if (this.ready == 0) { return; }
        int32 k = rmlKey(code: code);
        if (k == 0) { return; }
        bool held = this.focusHeld();
        this.ctx.key(key: k, down: down, mods: rmlMods(mods: mods));

        // Nothing to move FROM (the document itself holds focus, after a click on the background, or nothing does)
        // — put the ring on the first tab element and let this press be that, rather than lose it. RmlUi's own TAB from
        // the document has already done so; an arrow has not.
        if (down && navKey(code: code) && !held && !this.focusHeld()) {
            bool back = (mods & UI_MOD_SHIFT) != 0;
            Optional<Element> first = this.doc.nextTab(from: this.doc.root(), forward: !back, wrap: true);
            match (first) {
                case Some(value: f): { f.focus(visible: true); }
                case None: { }
            };
        }
    }

    // Natively there is no platform default to prevent: the program owns its window (host.kama).
    public unsafe fn void claimKey(int32 key, int32 mods) { }

    public unsafe fn void copyText(const ref string text)
    {
        if (this.ready == 0) { return; }
        this.lib.copyText(text: text);
    }

    public unsafe fn void provideClipboard(const ref string text)
    {
        if (this.ready == 0) { return; }
        this.lib.provideClipboard(text: text);
    }

    public unsafe fn Optional<string> takeClipboardWrite()
    {
        if (this.ready == 0) { return Optional::None; }
        return this.lib.takeClipboardWrite();
    }

    // ⚠️ THE DOCUMENT ITSELF IS A FOCUS TARGET AND MUST NOT COUNT: with nothing focused RmlUi reports the document, and
    // treating that as "the ring holds something" would suppress every screen verb forever. `Document.focused` already
    // answers None for it. A DISABLED control still counts, deliberately: a ring parked on it is a ring the player sees.
    public unsafe fn bool focusHeld()
    {
        if (this.ready == 0) { return false; }
        Optional<Element> f = this.doc.focused();
        return match (f) { case Some(value: e): true; case None: false; };
    }

    // ⚠️ WITHOUT IT A PAD CANNOT REACH THE DOCUMENT: RmlUi's TAB walk does nothing while the document is unfocused, so
    // navigation used to work only after a mouse click (found in a game built on this seam).
    public unsafe fn void focusDocument()
    {
        if (this.ready == 0) { return; }
        Element root = this.doc.root();
        root.focus(visible: false);
    }

    public unsafe fn int32 bindElement(const ref string elementId)
    {
        if (this.ready == 0) { return 0; }
        Optional<Binding> b = this.doc.bind(id: elementId);
        return match (b) {
            case None: 0;
            case Some(value: binding): {
                // Idempotent per (event, flags), so binding twice listens once — and a click is never reported twice.
                // ⚠️ FOCUS AND BLUR IN THE CAPTURE PHASE: RmlUi's do not bubble (it sends one to every element joining or
                // leaving the focus chain instead), so a bound container hears its children's only on the way down.
                // The web leg listens the same way, so both deliver them ancestors first.
                string click = "click";
                string change = "change";
                string dblclick = "dblclick";
                string dragdrop = "dragdrop";
                string focus = "focus";
                string blur = "blur";
                binding.listen(event: click, flags: LISTEN_BUBBLE);
                binding.listen(event: change, flags: LISTEN_BUBBLE);
                binding.listen(event: dblclick, flags: LISTEN_BUBBLE);
                binding.listen(event: dragdrop, flags: LISTEN_BUBBLE);
                binding.listen(event: focus, flags: LISTEN_CAPTURE);
                binding.listen(event: blur, flags: LISTEN_CAPTURE);
                this.store[0].listen(binding: binding.handle());
                := binding.handle();
            }
        };
    }

    // A binding with no `listen`: @kama/rmlui's bindings carry only the listeners asked of them.
    // 0 when no element has the id now, as on the web: a binding named before outlives its element (it names the next
    // one with its id), so the binding is asked for its element (FIXED 0.5.1: it answered the handle with none).
    public unsafe fn int32 findElement(const ref string elementId)
    {
        if (this.ready == 0) { return 0; }
        Optional<Binding> b = this.doc.bind(id: elementId);
        return match (b) {
            case None: 0;
            case Some(value: x): {
                Optional<Element> e = x.element();
                := match (e) { case None: 0; case Some(value: _): x.handle(); };
            }
        };
    }

    // Touched first: a binding whose document has gone is forgotten on its first use, so its id then reads "" — as on
    // the web, where a new document drops every binding at once.
    public unsafe fn string elementId(int32 handle)
    {
        if (this.ready == 0 || handle == 0) { return ""; }
        Binding b = Binding.fromHandle(handle: handle);
        Optional<Element> touched = b.element();
        return b.id();
    }

    public unsafe fn UiRect elementRect(int32 handle)
    {
        Optional<Element> e = this.bound(handle: handle);
        return match (e) {
            case None: UiRect.empty();
            case Some(value: el): {
                Rect r = el.rect(area: BoxArea::Border);
                := UiRect.make(x: r.x, y: r.y, width: r.width, height: r.height);
            }
        };
    }

    // RmlUi formats a range's value as decimal text, so this is a round trip through a string; a value that does not
    // parse reads as 0 rather than as whatever the parser felt like.
    public unsafe fn float32 elementValue(int32 handle)
    {
        Optional<Element> e = this.bound(handle: handle);
        Optional<string> v = match (e) { case None: Optional::None; case Some(value: el): el.value(); };
        string text = match (v) { case None: ""; case Some(value: s): copy s; };
        if (text.isEmpty()) { return 0.0; }
        Result<float32, ParseError> r = parse::<float32>(s: text);
        return match (r) { case Ok(value: f): f; case Err(error: x): 0.0; };
    }

    public unsafe fn void setElementValue(int32 handle, float32 value)
    {
        Optional<Element> e = this.bound(handle: handle);
        string text = "${value}";
        match (e) { case Some(value: el): { el.setValue(value: text, quiet: true); } case None: { } };
    }

    // ⚠️ THROUGH THE `class` ATTRIBUTE (CHANGED in 0.2.2), as a browser's `classList` writes it. RmlUi keeps a class
    // `setClass` toggled BESIDE the attributes, so serializing the element — which `appendInnerRml` does here — wrote
    // the markup's classes back and dropped the toggled one. RmlUi turns the attribute into the class list itself.
    public unsafe fn void setElementClass(int32 handle, const ref string name, bool on)
    {
        Optional<Element> e = this.bound(handle: handle);
        match (e) { case None: { } case Some(value: el): { classOn(el: el, name: name, on: on); } };
    }

    public unsafe fn bool setElementProperty(int32 handle, const ref string name, const ref string value)
    {
        Optional<Element> e = this.bound(handle: handle);
        return match (e) { case Some(value: el): el.setProperty(name: name, value: value); case None: false; };
    }

    // ⚠️ EVERY ATTRIBUTE IS WRITTEN QUIETLY (CHANGED in 0.2.1): RmlUi raises a change for a write to a control's state
    // — a checkbox's or a radio's `checked`, a range's or a field's `value` — where a browser raises none for a script's
    // write. @kama/rmlui 0.1.1's quiet writes queue none, so the legs agree. `value` on a control goes through the quiet
    // `setValue`, as `setElementText` does.
    public unsafe fn void setElementAttribute(int32 handle, const ref string name, const ref string value)
    {
        Optional<Element> e = this.bound(handle: handle);
        match (e) {
            case None: { }
            case Some(value: el): {
                if (name == "value" && el.setValue(value: value, quiet: true)) { return; }
                el.setAttributeQuietly(name: name, value: value);
                if (name == "draggable") { el.removeProperty(name: "drag"); this.dress(el: el); }
            }
        };
    }

    // A control's `value` is emptied quietly rather than removed, so it reads back "" on both legs.
    public unsafe fn void removeElementAttribute(int32 handle, const ref string name)
    {
        Optional<Element> e = this.bound(handle: handle);
        match (e) {
            case None: { }
            case Some(value: el): {
                string none = "";
                if (name == "value" && el.setValue(value: none, quiet: true)) { return; }
                el.removeAttributeQuietly(name: name);
                if (name == "draggable") { el.removeProperty(name: "drag"); }
            }
        };
    }

    // RmlUi keeps a checkbox's state in its `checked` attribute and nowhere else. Only an `<input>` answers, as only one
    // has `.checked` on the web.
    public unsafe fn bool elementChecked(int32 handle)
    {
        Optional<Element> e = this.bound(handle: handle);
        Element el = Element.fromHandle(handle: 0);
        match (e) { case None: { return false; } case Some(value: x): { el = x; } };
        if (el.tag() != "input") { return false; }
        Optional<string> c = el.attribute(name: "checked");
        return match (c) { case None: false; case Some(value: s): true; };
    }

    public unsafe fn string elementText(int32 handle)
    {
        Optional<Element> e = this.bound(handle: handle);
        Optional<string> v = match (e) { case None: Optional::None; case Some(value: el): el.value(); };
        return match (v) { case None: ""; case Some(value: s): copy s; };
    }

    public unsafe fn void setElementText(int32 handle, const ref string text)
    {
        Optional<Element> e = this.bound(handle: handle);
        match (e) { case Some(value: el): { el.setValue(value: text, quiet: true); } case None: { } };
    }

    // What the bindings heard, translated (`heard`), and what the package's own listeners on the root heard (`own`):
    // a key becomes a `Key` event, the rest is the drag's classes and the tooltip's dismissal. Anything else is skipped.
    public unsafe fn Optional<UiEvent> pollEvent()
    {
        if (this.ready == 0) { return Optional::None; }
        while (true) {
            Optional<Event> next = this.ctx.pollEvent();
            match (next) {
                case None: { return this.store[0].poll(); }
                case Some(value: ev): {
                    Optional<UiEvent> found = Optional::None;
                    if (ev.binding.isNone()) { found = this.own(ev: ev); } else { found = this.heard(ev: ev); }
                    match (found) { case Some(value: u): { return Optional::Some(value: u); } case None: { } };
                }
            };
        }
    }

    unsafe fn Optional<UiEvent> heard(Event ev)
    {
        int32 element = ev.binding.handle();
        int32 mods = uiMods(m: this.lib.eventModifiers());
        return match (ev.type) {
            case Click: Optional::Some(value: UiEvent.make(kind: UiEventKind::Click, element: element,
                                                            target: this.targetOf(ev: ev), source: 0, key: 0, mods: mods, files: 0, atX: 0.0, atY: 0.0));
            case Dblclick: Optional::Some(value: UiEvent.make(kind: UiEventKind::DoubleClick, element: element,
                                                               target: this.targetOf(ev: ev), source: 0, key: 0, mods: mods, files: 0, atX: 0.0, atY: 0.0));
            case Change: {
                if (this.notAnEdit(ev: ev)) { return Optional::None; }
                := Optional::Some(value: UiEvent.make(kind: UiEventKind::Change, element: element,
                                                       target: this.targetOf(ev: ev), source: 0, key: 0, mods: 0, files: 0, atX: 0.0, atY: 0.0));
            }
            case Focus: {
                if (!focusable(el: ev.target)) { return Optional::None; }
                := Optional::Some(value: UiEvent.make(kind: UiEventKind::Focus, element: element,
                                                       target: this.targetOf(ev: ev), source: 0, key: 0, mods: 0, files: 0, atX: 0.0, atY: 0.0));
            }
            case Blur: {
                if (!focusable(el: ev.target)) { return Optional::None; }
                := Optional::Some(value: UiEvent.make(kind: UiEventKind::Blur, element: element,
                                                       target: this.targetOf(ev: ev), source: 0, key: 0, mods: 0, files: 0, atX: 0.0, atY: 0.0));
            }
            case Dragdrop: {
                string dragName = "drag_element";
                Optional<Element> dragged = this.lib.eventElement(name: dragName);
                int32 source = match (dragged) { case None: 0; case Some(value: d): this.named(el: d); };
                int32 target = this.dropTargetOf(at: ev.target, stop: ev.element);
                // Where the pointer was at the drop — RmlUi's own parameters, this poll's — not where it is now: the
                // program may have moved it since.
                string mx = "mouse_x";
                string my = "mouse_y";
                float32 px = cast<float32>(this.lib.eventInt(name: mx, fallback: cast<int32>(this.pointerX)));
                float32 py = cast<float32>(this.lib.eventInt(name: my, fallback: cast<int32>(this.pointerY)));
                float32 atX = this.within(handle: target, x: px, horizontal: true);
                float32 atY = this.within(handle: target, x: py, horizontal: false);
                := Optional::Some(value: UiEvent.make(kind: UiEventKind::Drop, element: element, target: target,
                                                       source: source, key: 0, mods: mods, files: 0, atX: atX, atY: atY));
            }
            case _: Optional::None;
        };
    }

    // The package's own listeners on the document's root (`adopt`).
    unsafe fn Optional<UiEvent> own(Event ev)
    {
        string dragName = "drag_element";
        string dragging = "ui-dragging";
        string dropTarget = "ui-drop-target";
        match (ev.type) {
            case Keydown: {
                string identifier = "key_identifier";
                int32 key = uiKey(k: this.lib.eventInt(name: identifier, fallback: -1));
                int32 mods = uiMods(m: this.lib.eventModifiers());
                if (!reported(key: key, mods: mods)) { return Optional::None; }
                return Optional::Some(value: UiEvent.make(kind: UiEventKind::Key, element: 0,
                                                          target: this.targetOf(ev: ev), source: 0, key: key, mods: mods, files: 0, atX: 0.0, atY: 0.0));
            }
            case Scroll: { this.dismissTip(); }
            case Dragstart: {
                Optional<Element> dragged = this.lib.eventElement(name: dragName);
                match (dragged) { case None: { } case Some(value: d): { classOn(el: d, name: dragging, on: true); } };
            }
            case Dragover: {
                Element over = this.zoneOf(el: ev.target);
                if (over.isLive()) {
                    this.clearClass(name: dropTarget, except: over);
                    classOn(el: over, name: dropTarget, on: true);
                }
            }
            case Dragout: {
                // Left for good only if the pointer is outside it now: moving between the parts of one row raises a
                // dragout on the part it leaves, which must not take the row's class off.
                Element left = this.zoneOf(el: ev.target);
                if (left.isLive()) {
                    Rect r = left.rect(area: BoxArea::Border);
                    bool inside = this.pointerX >= r.x && this.pointerX < r.x + r.width &&
                                  this.pointerY >= r.y && this.pointerY < r.y + r.height;
                    if (!inside) { classOn(el: left, name: dropTarget, on: false); }
                }
            }
            case Dragend: {
                Optional<Element> dragged = this.lib.eventElement(name: dragName);
                match (dragged) { case None: { } case Some(value: d): { classOn(el: d, name: dragging, on: false); } };
                this.clearClass(name: dragging, except: Element.fromHandle(handle: 0));
                this.clearClass(name: dropTarget, except: Element.fromHandle(handle: 0));
            }
            case _: { }
        };
        return Optional::None;
    }

    // Take a class off every element of the document that has it, but `except`.
    unsafe fn void clearClass(const ref string name, Element except)
    {
        if (!this.doc.isLive()) { return; }
        Element root = this.doc.root();
        string selector = ".${name}";
        int32 left = 256;
        while (left > 0) {
            Optional<Element> e = root.query(selector: selector);
            match (e) {
                case None: { return; }
                case Some(value: el): {
                    if (el.same(other: except)) { return; }
                    classOn(el: el, name: name, on: false);
                }
            };
            left = left - 1;
        }
    }

    // The nearest element at or above `el` with an id, inside the document; a dead element when there is none.
    unsafe fn Element withId(Element el)
    {
        Element at = el;
        Element root = this.doc.root();
        while (at.isLive()) {
            string id = at.id();
            if (!id.isEmpty()) { return at; }
            if (at.same(other: root)) { return Element.fromHandle(handle: 0); }
            Optional<Element> up = at.parent();
            match (up) { case None: { return Element.fromHandle(handle: 0); } case Some(value: p): { at = p; } };
        }
        return Element.fromHandle(handle: 0);
    }

    // `withId`, as a handle — a Drop's `source`.
    unsafe fn int32 named(Element el)
    {
        Element at = this.withId(el: el);
        if (!at.isLive()) { return 0; }
        string id = at.id();
        return this.findElement(elementId: id);
    }

    // ⚠️ ONE CHANGE PER EDIT (host.kama), the count the web leg gets by hearing `input` from a text field, a textarea and
    // a range and `change` from everything else. RmlUi raises two Changes that are no person's edit: ENTER in a text
    // field (`linebreak` — a commit, which the web counts as nothing either) and the radio a choice UNCHECKS (its
    // neighbour's side effect; a browser raises nothing on it). Read from the event's own parameters, which are this
    // poll's until the next.
    unsafe fn bool notAnEdit(Event ev)
    {
        string linebreak = "linebreak";
        if (this.lib.eventInt(name: linebreak, fallback: 0) != 0) { return true; }
        string checkedName = "checked";
        if (this.lib.eventInt(name: checkedName, fallback: 1) != 0) { return false; }
        if (ev.target.tag() != "input") { return false; }
        Optional<string> kind = ev.target.attribute(name: "type");
        return match (kind) { case None: false; case Some(value: s): s == "radio"; };
    }

    // The nearest element WITH AN ID from where the event happened up to the element that heard it (inclusive), as the
    // binding for that id — the handle `bindElement` returns, named here as `findElement` names it. The walk happens at
    // the poll, over handles that read as dead once their element is gone, so a target a rewrite destroyed is 0 (the
    // web leg makes the same check at the same moment).
    unsafe fn int32 targetOf(Event ev)
    {
        Element at = ev.target;
        while (at.isLive()) {
            string id = at.id();
            if (!id.isEmpty()) { return this.findElement(elementId: id); }
            if (at.same(other: ev.element)) { return 0; }
            Optional<Element> up = at.parent();
            match (up) { case None: { return 0; } case Some(value: p): { at = p; } };
        }
        return 0;
    }

    public unsafe fn void typeChar(int32 codepoint)
    {
        if (this.ready == 0 || codepoint < 0) { return; }
        this.ctx.text(codepoint: codepoint);
    }

    public unsafe fn bool focusElement(int32 handle)
    {
        Optional<Element> e = this.bound(handle: handle);
        return match (e) { case Some(value: el): el.focus(visible: true); case None: false; };
    }

    public unsafe fn int32 focusedElement()
    {
        if (this.ready == 0) { return 0; }
        Optional<Element> f = this.doc.focused();
        Optional<Binding> b = match (f) { case None: Optional::None; case Some(value: e): this.doc.bindingOf(element: e); };
        return match (b) { case None: 0; case Some(value: x): x.handle(); };
    }

    public unsafe fn bool textFocused()
    {
        if (this.ready == 0) { return false; }
        Optional<Element> f = this.doc.focused();
        Element e = Element.fromHandle(handle: 0);
        match (f) { case None: { return false; } case Some(value: x): { e = x; } };
        string tag = e.tag();
        if (tag == "textarea") { return true; }
        if (tag != "input") { return false; }
        // CHANGED (0.5.0): every type a person types into (host.kama), read as kama_ui_web.js reads it — the attribute,
        // in any case, absent or empty being `text` — rather than as RmlUi classes it, since RmlUi makes every type it
        // does not know (`date` among them) a text field, which a browser does not.
        Optional<string> t = e.attribute(name: "type");
        string kind = match (t) { case None: "text"; case Some(value: s): s.toLower(); };
        if (kind.isEmpty()) { return true; }
        return kind == "text" || kind == "password" || kind == "number" || kind == "search" || kind == "email" ||
               kind == "url" || kind == "tel";
    }

    public unsafe fn void setDpRatio(float32 ratio)
    {
        if (this.ready == 0) { return; }
        this.ctx.setDpRatio(ratio: ratio);
    }

    public unsafe fn void closeDocument()
    {
        if (this.ready == 0) { return; }
        this.closeCurrent();
    }

    public unsafe fn void close()
    {
        if (this.ready == 0) { return; }
        this.ctx.destroy();
        this.lib.shutdown();
        this.ready = 0;
        Owned<FileStore> back = Owned.adopt(raw: this.store);
        this.store = null;
    }

    // ---- 0.4.0: drop zones and files (host.kama) ------------------------------------------------------------------

    // `droppable="true"` with an id: a zone.
    unsafe fn bool isZone(Element el)
    {
        if (el.id().isEmpty()) { return false; }
        Optional<string> d = el.attribute(name: "droppable");
        return match (d) { case None: false; case Some(value: v): v == "true"; };
    }

    // What is highlighted under the pointer: the nearest zone at or above `el`, else the nearest element with an id.
    unsafe fn Element zoneOf(Element el)
    {
        Element at = el;
        Element root = this.doc.root();
        while (at.isLive()) {
            if (this.isZone(el: at)) { return at; }
            if (at.same(other: root)) { break; }
            Optional<Element> up = at.parent();
            match (up) { case None: { break; } case Some(value: p): { at = p; } };
        }
        return this.withId(el: el);
    }

    // A drop's target, from where it landed up to the element that heard it (inclusive): the nearest zone, else the
    // nearest element with an id — as a handle, named as `targetOf` names one. 0 for neither.
    unsafe fn int32 dropTargetOf(Element at, Element stop)
    {
        Element n = at;
        while (n.isLive()) {
            if (this.isZone(el: n)) { return this.findElement(elementId: n.id()); }
            if (n.same(other: stop)) { break; }
            Optional<Element> up = n.parent();
            match (up) { case None: { break; } case Some(value: p): { n = p; } };
        }
        n = at;
        while (n.isLive()) {
            string id = n.id();
            if (!id.isEmpty()) { return this.findElement(elementId: id); }
            if (n.same(other: stop)) { return 0; }
            Optional<Element> up = n.parent();
            match (up) { case None: { return 0; } case Some(value: p): { n = p; } };
        }
        return 0;
    }

    // Where `x` (or a y, for `horizontal` false) lies across the handle's border box: 0 to 1, clamped; 0 for none.
    unsafe fn float32 within(int32 handle, float32 x, bool horizontal)
    {
        UiRect r = this.elementRect(handle: handle);
        float32 from = r.x;
        float32 size = r.width;
        if (!horizontal) { from = r.y; size = r.height; }
        if (size <= 0.0) { return 0.0; }
        float32 f = (x - from) / size;
        if (f < 0.0) { return 0.0; }
        if (f > 1.0) { return 1.0; }
        return f;
    }

    // One at a time, and only with a document up, as on the web; the request waits for `takeFileRequest`.
    public unsafe fn int32 chooseFiles(const ref string accept, bool multiple)
    {
        if (this.ready == 0 || !this.doc.isLive()) { return 0; }
        return this.store[0].choose(accept: accept, multiple: multiple);
    }

    public unsafe fn int32 fileCount(int32 files)
    {
        if (this.ready == 0) { return 0; }
        return this.store[0].count(files: files);
    }

    // The path's last part, as a browser's `File.name` is.
    public unsafe fn string fileName(int32 files, int32 index)
    {
        string p = this.filePath(files: files, index: index);
        if (p.isEmpty()) { return ""; }
        Optional<string> name = fileName(path: p);
        return match (name) { case None: copy p; case Some(value: n): copy n; };
    }

    public unsafe fn int64 fileSize(int32 files, int32 index)
    {
        if (this.ready == 0) { return -1; }
        return this.store[0].size(files: files, index: index);
    }

    public unsafe fn string fileType(int32 files, int32 index)
    {
        string name = this.fileName(files: files, index: index);
        if (name.isEmpty()) { return ""; }
        return uiFileType(name: name);
    }

    public unsafe fn string filePath(int32 files, int32 index)
    {
        if (this.ready == 0) { return ""; }
        return this.store[0].path(files: files, index: index);
    }

    public unsafe fn void releaseFiles(int32 files)
    {
        if (this.ready == 0) { return; }
        this.store[0].release(files: files);
    }

    // Read at once, natively; the Read event comes at the next poll, as the web's comes when its promise settles.
    public unsafe fn int32 readFile(int32 files, int32 index, int64 offset, int32 count)
    {
        if (this.ready == 0) { return 0; }
        return this.store[0].read(files: files, index: index, offset: offset, count: count);
    }

    public unsafe fn bool readBytes(int32 read, ref DynamicArray<uint8> into)
    {
        if (this.ready == 0) { into.clear(); return false; }
        return this.store[0].takeRead(read: read, into: into);
    }

    public unsafe fn string readError(int32 read)
    {
        if (this.ready == 0) { return ""; }
        return this.store[0].readError(read: read);
    }

    // Held until the program takes it (`takeSaveRequest`) and shows its save dialog.
    public unsafe fn bool saveFile(const ref string name, ConstView<uint8> bytes)
    {
        if (this.ready == 0) { return false; }
        this.store[0].save(name: name, bytes: bytes);
        return true;
    }

    public unsafe fn int32 takeFileRequest()
    {
        if (this.ready == 0) { return 0; }
        return this.store[0].takeRequest();
    }

    public unsafe fn string fileRequestAccept(int32 files)
    {
        if (this.ready == 0) { return ""; }
        return this.store[0].accept(files: files);
    }

    public unsafe fn bool fileRequestMultiple(int32 files)
    {
        if (this.ready == 0) { return false; }
        return this.store[0].multiple(files: files);
    }

    public unsafe fn void provideFiles(int32 files, const ref DynamicArray<string> paths)
    {
        if (this.ready == 0) { return; }
        this.store[0].provide(files: files, paths: paths);
    }

    // A drop on what lies at the point, heard by each bound ancestor in turn from the innermost — RmlUi's bubbling,
    // which a drop from outside never goes through — all with one list. Nobody to hear it: the list is let go.
    public unsafe fn void dropFiles(const ref DynamicArray<string> paths, float32 x, float32 y)
    {
        if (this.ready == 0 || !this.doc.isLive() || paths.length() == 0) { return; }
        Optional<Element> hit = this.ctx.elementAtPoint(x: x, y: y);
        Element at = match (hit) { case None: Element.fromHandle(handle: 0); case Some(value: e): e; };
        if (!at.isLive()) { return; }
        int32 list = this.store[0].list(paths: paths);
        int32 heard = 0;
        Element n = at;
        Element root = this.doc.root();
        while (n.isLive()) {
            Optional<Binding> b = this.doc.bindingOf(element: n);
            int32 binding = match (b) { case None: 0; case Some(value: found): found.handle(); };
            if (binding != 0 && this.store[0].listens(binding: binding)) {
                int32 target = this.dropTargetOf(at: at, stop: n);
                float32 atX = this.within(handle: target, x: x, horizontal: true);
                float32 atY = this.within(handle: target, x: y, horizontal: false);
                this.store[0].post(ev: UiEvent.make(kind: UiEventKind::Drop, element: binding, target: target, source: 0,
                                                    key: 0, mods: 0, files: list, atX: atX, atY: atY));
                heard = heard + 1;
            }
            if (n.same(other: root)) { break; }
            Optional<Element> up = n.parent();
            match (up) { case None: { break; } case Some(value: p): { n = p; } };
        }
        if (heard == 0) { this.store[0].release(files: list); }
    }

    // A paste is the document's, as a key is: `target` the focused element.
    public unsafe fn void pasteFiles(const ref DynamicArray<string> paths)
    {
        if (this.ready == 0 || !this.doc.isLive() || paths.length() == 0) { return; }
        int32 list = this.store[0].list(paths: paths);
        Optional<Element> f = this.doc.focused();
        int32 target = match (f) { case None: 0; case Some(value: e): this.named(el: e); };
        this.store[0].post(ev: UiEvent.make(kind: UiEventKind::Paste, element: 0, target: target, source: 0, key: 0,
                                            mods: 0, files: list, atX: 0.0, atY: 0.0));
    }

    public unsafe fn int32 takeSaveRequest()
    {
        if (this.ready == 0) { return 0; }
        return this.store[0].takeSave();
    }

    public unsafe fn string saveRequestName(int32 save)
    {
        if (this.ready == 0) { return ""; }
        return this.store[0].saveName(save: save);
    }

    public unsafe fn bool saveRequestBytes(int32 save, ref DynamicArray<uint8> into)
    {
        if (this.ready == 0) { into.clear(); return false; }
        return this.store[0].takeSaveBytes(save: save, into: into);
    }

    // ---- 0.5.0: media (host.kama) ----
    //
    // ⚠️ NO ELEMENT HERE IS A MEDIA ELEMENT. RmlUi has no `<video>` or `<audio>` — it decodes no media, and a document's
    // `<video>` is a plain element that lays out as an empty box — so every answer is None or false whatever the handle
    // names, and no `Media` event is ever queued. What changes when the toolkit gets a decoder is these bodies and a
    // source for the event; the contract and every program written against it stay as they are.
    public unsafe fn Optional<float64> mediaTime(int32 handle) { return Optional::None; }
    public unsafe fn Optional<float64> mediaDuration(int32 handle) { return Optional::None; }
    public unsafe fn Optional<bool> mediaPaused(int32 handle) { return Optional::None; }
    public unsafe fn bool seekMedia(int32 handle, float64 seconds) { return false; }
    public unsafe fn bool playMedia(int32 handle) { return false; }
    public unsafe fn bool pauseMedia(int32 handle) { return false; }
}
