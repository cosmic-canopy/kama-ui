file @compileFor(ARCH_WASM32);
// ui::web — the web UI backend: the browser's own DOM, behind a `--js-library` (kama_ui_web.js). No JS libraries: the
// page's DOM and CSS do everything.
//
// This package added `loadDocumentText` and `setImageRewrite`, and `provideImage` takes a view.
//
// The mirror of native.kama, gated the other way — and BOTH files carry a single `file` gate rather than one per
// declaration (kama 0.9.150). This file imports `std::fs` and `ui::uidoc`, neither of which has any business in the
// native build, and a per-declaration gate cannot gate an import block.
//
// ⚠️ THIS BACKEND PRODUCES NO DRAW COMMANDS, AND THAT IS THE DESIGN RATHER THAN AN OMISSION.
// `commandCount()` and `textureCount()` return 0 for ever. RmlUi hands geometry to a recording render
// interface because it cannot put pixels anywhere; a browser lays out and PAINTS the DOM itself, so
// the canvas draws nothing on the frames a screen is up and the document is real elements over it.
// One asset, two rasterizers: the browser rasterizes DOM text from the same `.ttf` FreeType reads natively.
//
// ⚠️ ONE ASSET, THOUGH. A program's `.rml` documents are the single source for both legs — RmlUi parses them, and
// `ui::uidoc::rmlToHtml` rewrites the same bytes into HTML here. There is no second copy of any screen.

import { UiHost, UiCommand, UiTexture, UiEvent, UiEventKind, UiRect,
         core::println,
         ui::uidoc::rmlToHtml, std::fs::readFile, std::io::IoError,
         std::collections::DynamicArray, std::collections::ConstView };
export { UiContext };

extern "kama_ui_web.h";

extern fn int32 kama_ui_web_init(int32 width, int32 height, int32 page);
extern fn int32 kama_ui_web_set_document(UnsafeConstPtr<cchar> html);
extern fn void  kama_ui_web_set_inner(int32 handle, UnsafeConstPtr<cchar> html);
extern fn int32 kama_ui_web_bind(UnsafeConstPtr<cchar> element_id);
extern fn int32 kama_ui_web_poll_event(UnsafePtr<int32> handle, UnsafePtr<int32> target);
extern fn void  kama_ui_web_set_viewport(float32 offset_x, float32 offset_y, float32 scale, int32 visible);
extern fn int32 kama_ui_web_element_rect(int32 handle, UnsafePtr<float32> x, UnsafePtr<float32> y, UnsafePtr<float32> width, UnsafePtr<float32> height);
extern fn float32 kama_ui_web_element_value(int32 handle);
extern fn void  kama_ui_web_set_value(int32 handle, float32 value);
extern fn void  kama_ui_web_set_class(int32 handle, UnsafeConstPtr<cchar> name, int32 on);
extern fn void  kama_ui_web_key(int32 key, int32 shift);
extern fn int32 kama_ui_web_focus_held();
extern fn void  kama_ui_web_focus_document();
extern fn void  kama_ui_web_shutdown();
// Text entry and focus (kama_ui_web.h).
extern fn int32 kama_ui_web_focus_element(int32 handle);
extern fn int32 kama_ui_web_focused();
extern fn int32 kama_ui_web_text_focused();
extern fn int32 kama_ui_web_element_text(int32 handle, UnsafePtr<cchar> buffer, int32 capacity);
extern fn void  kama_ui_web_set_text(int32 handle, UnsafeConstPtr<cchar> text);
extern fn void  kama_ui_web_close_document();
extern fn int32 kama_ui_web_set_property(int32 handle, UnsafeConstPtr<cchar> name, UnsafeConstPtr<cchar> value);
extern fn void  kama_ui_web_set_image_rewrite(UnsafeConstPtr<cchar> native_ext, UnsafeConstPtr<cchar> web_ext);
// 0.2.0 (kama_ui_web.h).
extern fn int32 kama_ui_web_element_id(int32 handle, UnsafePtr<cchar> buffer, int32 capacity);
extern fn void  kama_ui_web_set_attribute(int32 handle, UnsafeConstPtr<cchar> name, UnsafeConstPtr<cchar> value);
extern fn void  kama_ui_web_remove_attribute(int32 handle, UnsafeConstPtr<cchar> name);
extern fn int32 kama_ui_web_element_checked(int32 handle);
extern fn int32 kama_ui_web_find(UnsafeConstPtr<cchar> element_id);
extern fn void  kama_ui_web_scroll_to_end(int32 handle);

// The runtime string constructor. An `extern` is a reference to a C symbol rather than a module
// symbol — it is never exported or imported, so a file that names one declares it.
// ⚠️ `UnsafeConstPtr<uint8>` SINCE 0.9.209, AND IT MUST MATCH `std::io::streams`' DECLARATION
// EXACTLY. This is one C symbol; kama emits no prototype for an extern, so a mismatch cannot be
// caught downstream — call sites in BOTH files lower through whichever declaration was
// collected last. The compiler now says so by name and by parameter, which is how this was found.
extern fn string kama_string_from_raw(UnsafeConstPtr<uint8> src, isize start, isize len);

// The C side numbers its event kinds; this is the one place that mapping lives on this leg, and it
// is the same ladder native.kama carries.
fn UiEventKind kindOf(int32 raw)
{
    if (raw == 1) { return UiEventKind::Click; }
    if (raw == 2) { return UiEventKind::Change; }
    return UiEventKind::None;
}

// A zeroed buffer for a string the JS has already measured: `n` bytes and the NUL. ⚠️ MEASURED FIRST, NOT CAPPED:
// each string-returning JS call answers its value's full UTF-8 length whatever buffer it is handed, so it is asked
// once with none and once with one exactly that size. Nothing runs in between (the page is single-threaded and
// neither call yields), so the value cannot change size under the second read.
fn DynamicArray<uint8> sized(int32 n)
{
    isize size = cast<isize>(n) + 1;
    DynamicArray<uint8> buf = DynamicArray.withCapacity(capacity: size);
    isize i = 0;
    while (i < size) {
        buf.add(item: 0ui8);
        i = i + 1;
    }
    return buf;
}

// A `value` wrapping an int32 flag, exactly as the native context is, and for the same reason: there
// is one host, ownership lives on the other side of the seam, and `close()` is explicit.
type value UiContext implements UiHost {
    int32 ready;

    // ⚠️ `fontPath` IS IGNORED HERE, AND SO IS EVERY LATER `loadFont`. A browser takes its faces from
    // `@font-face` in the page's own stylesheet — the shell's — because it rasterizes DOM text
    // itself. The faces are therefore SERVED beside the page rather than embedded in the wasm
    // filesystem, which is the one place this leg's asset story genuinely differs from the native one.
    public unsafe ctor open(int32 width, int32 height, const ref string fontPath)
    {
        this.ready = kama_ui_web_init(width: width, height: height, page: 0);
    }

    // ADDED (0.2.0): a PAGE (host.kama). `width` and `height` are ignored here as `fontPath` is: the stage is pinned to
    // the window's four edges, so CSS sizes it and follows every resize, and it is shown at once, unscaled.
    public unsafe ctor openPage(int32 width, int32 height, const ref string fontPath)
    {
        this.ready = kama_ui_web_init(width: width, height: height, page: 1);
    }

    public fn bool isOpen() { return this.ready != 0; }

    public unsafe fn void loadFont(const ref string path, bool fallback) { }

    // ⚠️ A NO-OP FOR `loadFont`'s REASON EXACTLY, one asset later. A browser fetches an `<img src>`
    // over HTTP from the page's origin and decodes it itself, so there is no seam here that could
    // accept pixels. The image is therefore SERVED beside the page rather than embedded, and
    // `setImageRewrite` maps the native file's extension to the served one's.
    public unsafe fn void provideImage(const ref string name, ConstView<uint8> rgba, int32 width, int32 height) { }

    // Real on this leg: kama_ui_web.js rewrites every `<img src>` it inserts (documents and `setInnerRml` alike)
    // from `nativeExt` to `webExt`, in the markup before the browser parses it, so the wrong file is never fetched.
    public unsafe fn void setImageRewrite(const ref string nativeExt, const ref string webExt)
    {
        if (this.ready == 0) { return; }
        kama_ui_web_set_image_rewrite(native_ext: nativeExt.cstr(), web_ext: webExt.cstr());
    }

    // ⚠️ THE ONE METHOD ON THIS LEG THAT TOUCHES A FILE, and it is the backend that reads it because
    // that is what the native backend does too — RmlUi opens the path itself, inside the shim. The
    // TRANSFORM takes a string rather than a path for the reason `uidoc` states, so the split is:
    // this reads bytes, `uidoc` rewrites them, and nothing about the rewrite needs a filesystem.
    //
    // ⚠️ THE DOCUMENTS ARE `--embed-file`d INTO MEMFS by the program's WASM build, unlike its fonts. A
    // missing one returns false here — so the symptom is a screen that does not appear rather than an
    // error, on the one leg with no console anybody is watching. Hence the print.
    public unsafe fn bool loadDocument(const ref string path)
    {
        if (this.ready == 0) { return false; }

        DynamicArray<uint8> file = DynamicArray.empty();
        bool read = false;
        Result<DynamicArray<uint8>, IoError> r = readFile(path: path);
        match (give r) {
            case Err(error: e):    { println(s: "ui: cannot read ${path} — is it in the build's --embed-file list?"); }
            case Ok(value: bytes): { file = give bytes; read = true; }
        };
        if (!read) { return false; }

        isize n = file.length();
        if (n == 0) { return false; }
        // ⚠️ THIS FILE COMPILES ON THE WASM LEG ONLY, so a native build cannot catch a break here;
        // tools/test-web.sh is the check.
        UnsafeConstPtr<uint8> p = file.dataPtr();
        string rml = kama_string_from_raw(src: p, start: 0, len: n);
        return this.loadDocumentText(rml: rml);
    }

    public unsafe fn bool loadDocumentText(const ref string rml)
    {
        if (this.ready == 0) { return false; }
        string html = rmlToHtml(rml: rml);
        return kama_ui_web_set_document(html: html.cstr()) != 0;
    }

    // Real on this leg, where `loadFont` is not: the browser has no seam for a face and every seam
    // for markup. The JS releases the bindings inside before it writes (host.kama).
    public unsafe fn void setInnerRml(int32 handle, const ref string rml)
    {
        if (this.ready == 0) { return; }
        kama_ui_web_set_inner(handle: handle, html: rml.cstr());
    }

    // The stage is sized once, at `open` — so this has nothing left to do. A resize moves the letterbox,
    // which is `setViewport`, not a relayout. A page's stage is the window, which CSS resizes by itself.
    public unsafe fn void setSize(int32 width, int32 height) { }

    public unsafe fn void setViewport(float32 offsetX, float32 offsetY, float32 scale, bool visible)
    {
        if (this.ready == 0) { return; }
        int32 on = 0;
        if (visible) { on = 1; }
        kama_ui_web_set_viewport(offset_x: offsetX, offset_y: offsetY, scale: scale, visible: on);
    }

    // ⚠️ ALL EMPTY, AND NOT FOR WANT OF EFFORT. The browser lays out on its own schedule, keeps its own
    // clock and paints without being asked; there is no frame here to advance and no command list to
    // rebuild. The native ones exist because RmlUi has to be told.
    public unsafe fn void update() { }
    public unsafe fn void updateAt(float64 seconds) { }
    public unsafe fn void render() { }

    public unsafe fn int32 commandCount() { return 0; }

    public unsafe fn UiCommand command(int32 index) { return UiCommand.empty(); }

    public unsafe fn int32 textureCount() { return 0; }

    public unsafe fn UiTexture texture(int32 handle) { return UiTexture.empty(); }

    // No textures on this leg at all — the DOM backend draws its own text — so no slot can ever be
    // recycled and the answer is a constant.
    public unsafe fn int32 textureGeneration(int32 handle) { return 0; }

    // ⚠️ THE THREE POINTER METHODS STAY EMPTY, and each is a different reason worth keeping straight.
    // The browser does its OWN hit-testing and hover from the pointer events the page already
    // receives, so forwarding a second copy of the cursor would buy nothing; and it scrolls an
    // overflowing element itself, so forwarding the wheel would scroll it TWICE. The native
    // backend needs all three because RmlUi sees no events at all unless it is fed them.
    public unsafe fn void mouseMove(float32 x, float32 y) { }
    public unsafe fn void mouseButton(int32 button, bool down) { }
    public unsafe fn void mouseWheel(float32 delta) { }

    // ⚠️ **THE BROWSER OWNS FOCUS, BUT IT NEVER SEES THESE KEYS** — a game's platform layer registers its
    // key handlers on the WINDOW and preventDefault-s every mapped key before the DOM overlay could act
    // on it, which is what stops SPACE and the arrows scrolling the page out from under the game. So the
    // move has to be DRIVEN, which is what the JS side does — over the focusable elements of `#ui-root`,
    // in document order.
    //
    // ⚠️ Unlike the wheel, this is NOT a no-op on this leg. The wheel is empty here because the
    // browser scrolls an overflowing element itself and forwarding would scroll twice; a key is the
    // opposite case, because the one thing that would have moved the focus was suppressed upstream.
    public unsafe fn void key(int32 code, bool down, bool shift)
    {
        if (this.ready == 0) { return; }
        // Releases are dropped rather than forwarded: the DOM has no focus-move-on-release and the
        // activation happens on the press, so a keyup would be a call that can only do nothing.
        if (!down) { return; }
        int32 sh = 0;
        if (shift) { sh = 1; }
        kama_ui_web_key(key: code, shift: sh);
    }

    // ⚠️ **`ready == 0` ANSWERS FALSE.** With no document up there is no ring, so a confirm can only be
    // the screen's own verb.
    public unsafe fn bool focusHeld()
    {
        if (this.ready == 0) { return false; }
        return kama_ui_web_focus_held() != 0;
    }

    public unsafe fn void focusDocument() { kama_ui_web_focus_document(); }

    public unsafe fn int32 bindElement(const ref string elementId)
    {
        if (this.ready == 0) { return 0; }
        return kama_ui_web_bind(element_id: elementId.cstr());
    }

    public unsafe fn UiRect elementRect(int32 handle)
    {
        if (this.ready == 0) { return UiRect.empty(); }

        float32 x = 0;
        float32 y = 0;
        float32 w = 0;
        float32 h = 0;
        int32 ok = kama_ui_web_element_rect(handle: handle, x: addr(of: x), y: addr(of: y),
                                           width: addr(of: w), height: addr(of: h));
        if (ok == 0) { return UiRect.empty(); }
        return UiRect.make(x: x, y: y, width: w, height: h);
    }

    public unsafe fn float32 elementValue(int32 handle)
    {
        if (this.ready == 0) { return 0.0; }
        return kama_ui_web_element_value(handle: handle);
    }

    // See native.kama's twins and host.kama.
    public unsafe fn void setElementValue(int32 handle, float32 value)
    {
        if (this.ready == 0) { return; }
        kama_ui_web_set_value(handle: handle, value: value);
    }

    public unsafe fn void setElementClass(int32 handle, const ref string name, bool on)
    {
        if (this.ready == 0) { return; }
        int32 flag = 0;
        if (on) { flag = 1; }
        kama_ui_web_set_class(handle: handle, name: name.cstr(), on: flag);
    }

    // The target is walked in the JS, at this poll, as natively (types.kama, `UiEvent.target`).
    public unsafe fn Optional<UiEvent> pollEvent()
    {
        if (this.ready == 0) { return Optional::None; }
        int32 handle = 0;
        int32 target = 0;
        int32 raw = kama_ui_web_poll_event(handle: addr(of: handle), target: addr(of: target));
        if (raw == 0) { return Optional::None; }
        UiEvent ev = UiEvent.make(kind: kindOf(raw: raw), element: handle, target: target);
        return Optional::Some(value: ev);
    }

    public unsafe fn void close()
    {
        if (this.ready == 0) { return; }
        kama_ui_web_shutdown();
        this.ready = 0;
    }

    // ---- Text entry and focus (host.kama). The browser types, scales and keeps time itself: three no-ops. ----

    public unsafe fn void typeChar(int32 codepoint) { }

    public unsafe fn bool focusElement(int32 handle)
    {
        if (this.ready == 0) { return false; }
        return kama_ui_web_focus_element(handle: handle) != 0;
    }

    public unsafe fn int32 focusedElement()
    {
        if (this.ready == 0) { return 0; }
        return kama_ui_web_focused();
    }

    public unsafe fn bool textFocused()
    {
        if (this.ready == 0) { return false; }
        return kama_ui_web_text_focused() != 0;
    }

    // CHANGED (0.2.0): the whole value, as natively — measured, then read into a buffer that size (`sized`). It was
    // cut at 511 bytes, which a text editor's buffer passes in a paragraph.
    public unsafe fn string elementText(int32 handle)
    {
        if (this.ready == 0) { return ""; }
        int32 n = kama_ui_web_element_text(handle: handle, buffer: null, capacity: 0);
        if (n <= 0) { return ""; }
        DynamicArray<uint8> buf = sized(n: n);
        kama_ui_web_element_text(handle: handle, buffer: cast<UnsafePtr<cchar>>(buf.dataPtrMut()), capacity: n + 1);
        return kama_string_from_raw(src: buf.dataPtr(), start: 0, len: cast<isize>(n));
    }

    public unsafe fn void setElementText(int32 handle, const ref string text)
    {
        if (this.ready == 0) { return; }
        kama_ui_web_set_text(handle: handle, text: text.cstr());
    }

    public unsafe fn void setDpRatio(float32 ratio) { }

    // ---- 0.2.0 (host.kama) ----

    public unsafe fn int32 findElement(const ref string elementId)
    {
        if (this.ready == 0) { return 0; }
        return kama_ui_web_find(element_id: elementId.cstr());
    }

    // At once: the JS reads `scrollHeight`, which makes the browser lay out what was just written (host.kama).
    public unsafe fn void scrollToEnd(int32 handle)
    {
        if (this.ready == 0) { return; }
        kama_ui_web_scroll_to_end(handle: handle);
    }

    // Read as `elementText` is: measured, then read in full.
    public unsafe fn string elementId(int32 handle)
    {
        if (this.ready == 0) { return ""; }
        int32 n = kama_ui_web_element_id(handle: handle, buffer: null, capacity: 0);
        if (n <= 0) { return ""; }
        DynamicArray<uint8> buf = sized(n: n);
        kama_ui_web_element_id(handle: handle, buffer: cast<UnsafePtr<cchar>>(buf.dataPtrMut()), capacity: n + 1);
        return kama_string_from_raw(src: buf.dataPtr(), start: 0, len: cast<isize>(n));
    }

    public unsafe fn void setElementAttribute(int32 handle, const ref string name, const ref string value)
    {
        if (this.ready == 0) { return; }
        kama_ui_web_set_attribute(handle: handle, name: name.cstr(), value: value.cstr());
    }

    public unsafe fn void removeElementAttribute(int32 handle, const ref string name)
    {
        if (this.ready == 0) { return; }
        kama_ui_web_remove_attribute(handle: handle, name: name.cstr());
    }

    public unsafe fn bool elementChecked(int32 handle)
    {
        if (this.ready == 0) { return false; }
        return kama_ui_web_element_checked(handle: handle) != 0;
    }

    public unsafe fn void closeDocument()
    {
        if (this.ready == 0) { return; }
        kama_ui_web_close_document();
    }

    // One inline style property (host.kama).
    public unsafe fn bool setElementProperty(int32 handle, const ref string name, const ref string value)
    {
        if (this.ready == 0) { return false; }
        return kama_ui_web_set_property(handle: handle, name: name.cstr(), value: value.cstr()) != 0;
    }
}
