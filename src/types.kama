// ui::types — the values that cross the UI seam, and the key codes it takes.
//
// Three changes from the seam's earlier copies: the geometry pointers are READ-ONLY (`UnsafeConstPtr`, which the old C
// headers said was owed once kama could spell it), a command says what KIND it is (RmlUi 6's clip masks are now
// recorded, not dropped), and it carries RmlUi's transform.
//
// SEPARATE FROM host.kama ON PURPOSE: a `type contract` whose method returns a type declared in the contract's own file
// could not be satisfied from another file (a kama defect fixed in 0.9.134). There is no reason to move them back.

export {
    UiCommand, UiCommandKind, UiTexture, UiEvent, UiEventKind, UiRect,
    UI_KEY_ESCAPE, UI_KEY_ENTER, UI_KEY_TAB, UI_KEY_BACKSPACE, UI_KEY_DELETE, UI_KEY_RIGHT, UI_KEY_LEFT,
    UI_KEY_DOWN, UI_KEY_UP, UI_KEY_PAGE_UP, UI_KEY_PAGE_DOWN, UI_KEY_HOME, UI_KEY_END, UI_KEY_F1, UI_KEY_F2,
    UI_KEY_F3, UI_KEY_F4, UI_KEY_F5, UI_KEY_F6, UI_KEY_F7, UI_KEY_F8, UI_KEY_F9, UI_KEY_F10, UI_KEY_F11, UI_KEY_F12,
    UI_KEY_A, UI_KEY_B, UI_KEY_C, UI_KEY_D, UI_KEY_E, UI_KEY_F, UI_KEY_G, UI_KEY_H, UI_KEY_I, UI_KEY_J, UI_KEY_K,
    UI_KEY_L, UI_KEY_M, UI_KEY_N, UI_KEY_O, UI_KEY_P, UI_KEY_Q, UI_KEY_R, UI_KEY_S, UI_KEY_T, UI_KEY_U, UI_KEY_V,
    UI_KEY_W, UI_KEY_X, UI_KEY_Y, UI_KEY_Z, UI_KEY_0, UI_KEY_1, UI_KEY_2, UI_KEY_3, UI_KEY_4, UI_KEY_5, UI_KEY_6,
    UI_KEY_7, UI_KEY_8, UI_KEY_9,
    UI_MOD_SHIFT, UI_MOD_CTRL, UI_MOD_ALT, UI_TOOLTIP_DELAY,
    uiFileType,
};

// The keys, as GLFW numbers them. ⚠️ GLFW's NUMBERS, not RmlUi's and not the DOM's: a program forwards its platform's
// codes unchanged, and each backend translates — the native leg to RmlUi's KeyIdentifier, the web leg in
// kama_ui_web.js. No backend's key enum crosses the seam in either direction. A letter or a digit names the KEY, as
// GLFW's do (the US layout's position), not the character a layout types there.
//
// Two jobs, one table:
//   - `UiHost.key` takes all of them natively — the program forwards every key it does not keep for itself, with its
//     modifiers — and acts on a subset on both legs: TAB, the four arrows and ENTER move and press the focus ring;
//     BACKSPACE, DELETE, HOME and END edit a focused text field; natively CTRL+A, C, X and V select, copy, cut and
//     paste in one. ⚠️ SPACE IS NOT IN THE TABLE: RmlUi would take it as activation, and a game usually has it as a
//     screen verb — one key cannot mean "press this button" and "leave this screen" (`focusHeld` makes one key do both).
//   - `UiEventKind::Key` (0.3.0) reports them back, as `UiEvent.key`: every key here that types no character always,
//     and a letter or a digit only with CTRL or ALT held (a shortcut) — text arrives as `Change`, not keystroke by
//     keystroke.
comptime int32 UI_KEY_ESCAPE = 256;
comptime int32 UI_KEY_ENTER = 257;
comptime int32 UI_KEY_TAB = 258;
comptime int32 UI_KEY_BACKSPACE = 259;
comptime int32 UI_KEY_DELETE = 261;
comptime int32 UI_KEY_RIGHT = 262;
comptime int32 UI_KEY_LEFT = 263;
comptime int32 UI_KEY_DOWN = 264;
comptime int32 UI_KEY_UP = 265;
comptime int32 UI_KEY_PAGE_UP = 266;
comptime int32 UI_KEY_PAGE_DOWN = 267;
comptime int32 UI_KEY_HOME = 268;
comptime int32 UI_KEY_END = 269;
comptime int32 UI_KEY_F1 = 290;
comptime int32 UI_KEY_F2 = 291;
comptime int32 UI_KEY_F3 = 292;
comptime int32 UI_KEY_F4 = 293;
comptime int32 UI_KEY_F5 = 294;
comptime int32 UI_KEY_F6 = 295;
comptime int32 UI_KEY_F7 = 296;
comptime int32 UI_KEY_F8 = 297;
comptime int32 UI_KEY_F9 = 298;
comptime int32 UI_KEY_F10 = 299;
comptime int32 UI_KEY_F11 = 300;
comptime int32 UI_KEY_F12 = 301;
comptime int32 UI_KEY_A = 65;
comptime int32 UI_KEY_B = 66;
comptime int32 UI_KEY_C = 67;
comptime int32 UI_KEY_D = 68;
comptime int32 UI_KEY_E = 69;
comptime int32 UI_KEY_F = 70;
comptime int32 UI_KEY_G = 71;
comptime int32 UI_KEY_H = 72;
comptime int32 UI_KEY_I = 73;
comptime int32 UI_KEY_J = 74;
comptime int32 UI_KEY_K = 75;
comptime int32 UI_KEY_L = 76;
comptime int32 UI_KEY_M = 77;
comptime int32 UI_KEY_N = 78;
comptime int32 UI_KEY_O = 79;
comptime int32 UI_KEY_P = 80;
comptime int32 UI_KEY_Q = 81;
comptime int32 UI_KEY_R = 82;
comptime int32 UI_KEY_S = 83;
comptime int32 UI_KEY_T = 84;
comptime int32 UI_KEY_U = 85;
comptime int32 UI_KEY_V = 86;
comptime int32 UI_KEY_W = 87;
comptime int32 UI_KEY_X = 88;
comptime int32 UI_KEY_Y = 89;
comptime int32 UI_KEY_Z = 90;
comptime int32 UI_KEY_0 = 48;
comptime int32 UI_KEY_1 = 49;
comptime int32 UI_KEY_2 = 50;
comptime int32 UI_KEY_3 = 51;
comptime int32 UI_KEY_4 = 52;
comptime int32 UI_KEY_5 = 53;
comptime int32 UI_KEY_6 = 54;
comptime int32 UI_KEY_7 = 55;
comptime int32 UI_KEY_8 = 56;
comptime int32 UI_KEY_9 = 57;

// `UiEvent.mods` and `UiHost.key`'s `mods` (0.3.0): a mask, GLFW's bits. ⚠️ macOS's CMD IS FOLDED INTO CTRL — a
// program passes Cmd as UI_MOD_CTRL natively, and the web leg folds `metaKey` in — so one shortcut is written once
// (Ctrl+S is Cmd+S on a Mac).
comptime int32 UI_MOD_SHIFT = 1;
comptime int32 UI_MOD_CTRL = 2;
comptime int32 UI_MOD_ALT = 4;

// How long, in seconds of the clock `update`/`updateAt` keep, an element with a `title` is hovered before its tooltip
// shows (host.kama). kama_ui_web.js carries the same number.
comptime float64 UI_TOOLTIP_DELAY = 0.5;

// What an event is. Elements are INTEGER HANDLES from `bindElement`, never strings: dispatch is an integer compare
// rather than a string compare. 0.3.0 added every kind from `DoubleClick` to `Drop`, 0.4.0 `Files` to `Read`, 0.5.0
// `Media`, 0.6.0 `Commit`:
//   Click        a press and release on the element (ENTER on the focused one is one too)
//   Change       one edit of a control (host.kama, `pollEvent`)
//   DoubleClick  a second press within half a second, between the two clicks (the second click still follows)
//   Key          a key (types.kama's table) — the document's, so `element` is 0 and `target` names the focused element
//   Focus, Blur  a focusable element took or lost the focus: a button, a form control, or anything with a tab index
//   Drop         something was dropped on `target`: a dragged element (`source`), or files from outside the page
//                (CHANGED in 0.4.0: `source` 0 and `files` their list), at `atX`, `atY` in the target
//   Files        a `chooseFiles` was answered: `files` is the list it returned, now filled (empty: cancelled). The
//                document's, as a Key is: `element` and `target` 0
//   Paste        files were pasted (Ctrl+V of a copied file or a picture): the document's, `target` the focused
//                element, `files` their list
//   Read         a `readFile` finished: `files` is the read it returned (`readBytes`, `readError`); `element` 0
//   Media        a `<video>` or `<audio>` (`target`) loaded its metadata, played, paused, finished a seek, or moved on
//                while playing: read its state (host.kama, `mediaTime`…). One waits at a time per element and target.
//                On the web only: natively there is no media element yet
//   Commit       the person is done with a control's value (`target`), which changed since its last Commit: a range let
//                go or stepped by a key, ENTER in a text field, a text field or a textarea losing the focus, and each
//                toggle or choice of a checkbox, a radio or a select. It carries no value: the last Change did, so read
//                it (host.kama, `pollEvent`)
type enum UiEventKind { None, Click, Change, DoubleClick, Key, Focus, Blur, Drop, Files, Paste, Read, Media, Commit }

type value UiEvent {
    public UiEventKind kind;
    public int32 element;      // the handle `bindElement` returned: the bound element that heard it (0 for a Key)
    // ADDED (0.2.0): where it HAPPENED — the nearest element that has an id, walking up from the element the person hit
    // to the bound one (inclusive). So ONE binding on a list says which row or which button inside it was pressed.
    // It is the SAME handle `bindElement` gives for that id (the backend names it on the way out, without listening on
    // it): a button bound elsewhere still compares with `==`, and `UiHost.elementId` gives the id's text for a row
    // nobody bound. 0 when the target was destroyed (a `setInnerRml`) between the event and the poll.
    // ⚠️ A HANDLE, NOT THE ID'S TEXT: a `value` owns nothing and a `string` is owned, so carrying the text would make
    // every event a `resource` — no more copies out of a match arm, no more `Optional<UiEvent>` passed around freely.
    public int32 target;
    public int32 source;       // ADDED (0.3.0): a Drop's dragged element, named as `target` is; 0 for every other kind
    public int32 key;          // ADDED (0.3.0): a Key's UI_KEY_*; 0 for every other kind
    public int32 mods;         // ADDED (0.3.0): UI_MOD_* held — on a Key, a Click, a DoubleClick and a Drop; else 0
    // ADDED (0.4.0): what a Drop of files, a Files or a Paste carries — a FILE LIST (host.kama, `fileCount`…), the same
    // one on every event of one drop — and a Read's read (`readBytes`); 0 for every other kind, and for a Drop of an
    // element. A handle, as `target` is, and for the same reason: an event owns nothing.
    public int32 files;
    // ADDED (0.4.0): where a Drop landed in its `target`'s border box, 0 at the left (top) edge to 1 at the right
    // (bottom) — so a list can put what was dropped before a row (`atY < 0.5`) or after it. 0 for every other kind.
    public float32 atX;
    public float32 atY;

    // CHANGED (0.4.0): every field.
    public ctor make(UiEventKind kind, int32 element, int32 target, int32 source, int32 key, int32 mods, int32 files,
                     float32 atX, float32 atY)
    {
        this.kind = kind;
        this.element = element;
        this.target = target;
        this.source = source;
        this.key = key;
        this.mods = mods;
        this.files = files;
        this.atX = atX;
        this.atY = atY;
    }
}

// ADDED (0.4.0): a file's media type from its name's extension (ASCII, any case), as `fileType` reports it on both
// legs — the package's own table rather than a browser's or an OS's guess, so one file reads the same everywhere.
// "application/octet-stream" for an extension it does not know, and for none.
fn string uiFileType(const ref string name)
{
    isize dot = 0 - 1;
    isize i = 0;
    while (i < name.length()) {
        if (name[i] == 46ui8) { dot = i; }
        if (name[i] == 47ui8 || name[i] == 92ui8) { dot = 0 - 1; }
        i = i + 1;
    }
    if (dot < 0 || dot + 1 >= name.length()) { return "application/octet-stream"; }
    string ext = name.substring(start: dot + 1, end: name.length()).toLower();
    if (ext == "png") { return "image/png"; }
    if (ext == "jpg" || ext == "jpeg") { return "image/jpeg"; }
    if (ext == "webp") { return "image/webp"; }
    if (ext == "gif") { return "image/gif"; }
    if (ext == "bmp") { return "image/bmp"; }
    if (ext == "tif" || ext == "tiff") { return "image/tiff"; }
    if (ext == "svg") { return "image/svg+xml"; }
    if (ext == "avif") { return "image/avif"; }
    if (ext == "exr") { return "image/x-exr"; }
    if (ext == "hdr") { return "image/vnd.radiance"; }
    if (ext == "ktx2") { return "image/ktx2"; }
    if (ext == "mp4" || ext == "m4v") { return "video/mp4"; }
    if (ext == "webm") { return "video/webm"; }
    if (ext == "mov") { return "video/quicktime"; }
    if (ext == "mkv") { return "video/x-matroska"; }
    if (ext == "wav") { return "audio/wav"; }
    if (ext == "ogg" || ext == "oga") { return "audio/ogg"; }
    if (ext == "mp3") { return "audio/mpeg"; }
    if (ext == "flac") { return "audio/flac"; }
    if (ext == "glb") { return "model/gltf-binary"; }
    if (ext == "gltf") { return "model/gltf+json"; }
    if (ext == "obj") { return "model/obj"; }
    if (ext == "json") { return "application/json"; }
    if (ext == "txt" || ext == "log") { return "text/plain"; }
    if (ext == "md") { return "text/markdown"; }
    if (ext == "csv") { return "text/csv"; }
    if (ext == "html" || ext == "htm") { return "text/html"; }
    if (ext == "css") { return "text/css"; }
    if (ext == "pdf") { return "application/pdf"; }
    if (ext == "zip") { return "application/zip"; }
    return "application/octet-stream";
}

// What a command asks of the renderer. Apply them IN ORDER: a clip-mask command changes every draw after it.
//   Draw            draw the geometry (translation, texture, scissor, transform)
//   ClipEnable      from here on, draws are clipped to the clip mask
//   ClipDisable     from here on, they are not
//   ClipSet         the mask becomes this geometry's area (cleared first)
//   ClipSetInverse  the mask becomes everything OUTSIDE this geometry (cleared first)
//   ClipIntersect   the mask is intersected with this geometry
// ⚠️ A RENDERER THAT DOES NOT IMPLEMENT CLIP MASKS MUST SKIP EVERY NON-`Draw` COMMAND, not draw it: a ClipSet carries
// real geometry (a rounded box's shape) that is a mask, not a picture. RmlUi uses the mask for `overflow: hidden` inside
// a rounded border or a transform; skipping it draws the content unclipped there, which is what the seam's earlier copies always did.
type enum UiCommandKind { Draw, ClipEnable, ClipDisable, ClipSet, ClipSetInverse, ClipIntersect }

// One recorded command. `vertices` is a flat float32 array, 8 floats per vertex — x, y, u, v, r, g, b, a — with
// PREMULTIPLIED colour in 0..1. Both pointers are the backend's, READ-ONLY, and valid only until the next `update` or
// `render`; nothing here frees them (anything crossing the FFI seam is unowned).
type value UiCommand {
    public UiCommandKind kind;
    public UnsafeConstPtr<float32> vertices;
    public int32 vertexCount;
    public UnsafeConstPtr<int32> indices;
    public int32 indexCount;
    public int32 texture;          // 0 when the geometry is untextured
    public float32 translateX;
    public float32 translateY;
    public bool scissorEnabled;
    public int32 scissorX;
    public int32 scissorY;
    public int32 scissorWidth;
    public int32 scissorHeight;
    // RCSS `transform`: a column-major 4x4 applied after the translation; the identity when `transformed` is false.
    public bool transformed;
    public InlineArray<float32>#(16) transform;

    // What a backend with nothing to draw returns, and what an out-of-range index yields.
    public unsafe ctor empty()
    {
        this.kind = UiCommandKind::Draw;
        this.vertices = null;
        this.vertexCount = 0;
        this.indices = null;
        this.indexCount = 0;
        this.texture = 0;
        this.translateX = 0.0;
        this.translateY = 0.0;
        this.scissorEnabled = false;
        this.scissorX = 0;
        this.scissorY = 0;
        this.scissorWidth = 0;
        this.scissorHeight = 0;
        this.transformed = false;
        this.transform = [1.0f32, 0.0f32, 0.0f32, 0.0f32, 0.0f32, 1.0f32, 0.0f32, 0.0f32,
                          0.0f32, 0.0f32, 1.0f32, 0.0f32, 0.0f32, 0.0f32, 0.0f32, 1.0f32];
    }
}

// A texture the UI generated — the font atlas, built during layout — or a provided image once a document showed it.
// RGBA8, four bytes a pixel, premultiplied alpha, tightly packed. Read-only.
type value UiTexture {
    public UnsafeConstPtr<uint8> pixels;
    public int32 width;
    public int32 height;

    public unsafe ctor make(UnsafeConstPtr<uint8> pixels, int32 width, int32 height)
    {
        this.pixels = pixels;
        this.width = width;
        this.height = height;
    }

    public unsafe ctor empty()
    {
        this.pixels = null;
        this.width = 0;
        this.height = 0;
    }
}

// An element's border box in framebuffer pixels. Zero-sized when the handle is unknown or nothing has laid out yet.
type value UiRect {
    public float32 x;
    public float32 y;
    public float32 width;
    public float32 height;

    public ctor make(float32 x, float32 y, float32 width, float32 height)
    {
        this.x = x;
        this.y = y;
        this.width = width;
        this.height = height;
    }

    public ctor empty()
    {
        this.x = 0.0;
        this.y = 0.0;
        this.width = 0.0;
        this.height = 0.0;
    }
}
