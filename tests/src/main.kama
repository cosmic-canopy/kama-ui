// @kama/ui's tests: one program, built twice — natively (tools/test.sh, debug and release, through @kama/rmlui) and for
// the browser (tools/test-web.sh, emcc, run in a headless browser). The rewriter and the pad's presses are pure and run
// on both; the seam suite runs the same checks against whichever `UiContext` this build has. A failing case prints its
// name; the last line counts them.
//
// The files' checks (0.4.0) and then the media's (0.5.0) come last, as ticks of the program's frame loop
// (`std::app::run`): a read, a clip's metadata and a seek finish on their own time on the web, so they need the page to
// have its event loop between frames. On the web `run` does not return, so the report is made from the last tick;
// natively the loop returns and `main` hands back the verdict.

import {
    Tally, uidocTests, navTests, seamTests, pageTests, report, FileChecks, MediaChecks,
    std::app::run, std::app::TickFn, std::memory::Owned,
};

// What the loop ticks: the files' checks, then the media's, and the verdict once they are done. ⚠️ ONE UI OPEN AT A
// TIME, as a program has: each set opens its own, and two at once would share the web's one page (`open` there starts
// it afresh) and natively RmlUi itself (a `close` shuts it down). So the media's are made, on the heap, only once the
// files' have closed theirs, and dropped before the verdict.
type resource Run {
    FileChecks files;
    UnsafePtr<MediaChecks> media;   // null until the files' checks are done
    int32 code;
    bool done;

    public unsafe ctor make(Tally t)
    {
        this.files = FileChecks.make(t: t);
        this.media = null;
        this.code = 1;
        this.done = false;
    }

    public unsafe fn int32 tick()
    {
        if (this.done) { return 0; }
        if (this.media == null) {
            if (!this.files.tick()) { return 1; }
            Tally afterFiles = this.files.tally();
            Owned<MediaChecks> made = new MediaChecks.make(t: afterFiles);
            this.media = made.release();
            return 1;
        }
        if (!this.media[0].tick()) { return 1; }
        Tally t = this.media[0].tally();
        Owned<MediaChecks> back = Owned.adopt(raw: this.media);
        this.media = null;
        this.code = report(t: t);
        this.done = true;
        return 0;
    }

    public fn int32 verdict() { return this.code; }
}

unsafe fn int32 tick(UnsafePtr state)
{
    UnsafePtr<Run> r = cast<UnsafePtr<Run>>(state);
    return tickOnce(r: r[0]);
}

unsafe fn int32 tickOnce(ref Run r) { return r.tick(); }

unsafe fn int32 verdictOf(ref Run r) { return r.verdict(); }

unsafe fn int32 start()
{
    Tally t = Tally.zero();
    uidocTests(t: t);
    navTests(t: t);
    seamTests(t: t);
    pageTests(t: t);
    Owned<Run> boxed = new Run.make(t: t);
    UnsafePtr<Run> state = boxed.release();     // the loop's from here (on the web it outlives `main`)
    TickFn f = tick;
    run(tick: f, state: cast<UnsafePtr>(state));
    // Natively the loop has returned: the verdict, and the state given back to be dropped.
    int32 code = verdictOf(r: state[0]);
    Owned<Run> back = Owned.adopt(raw: state);
    return code;
}

fn int32 main() { return start(); }
