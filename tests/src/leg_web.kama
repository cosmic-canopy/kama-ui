file @compileFor(ARCH_WASM32);
// The web leg's half of the suite: input injected the way a person's arrives — the browser's own hit test
// (document.elementFromPoint) and the events a browser fires, in its order, from tests/web/kama_ui_test.js (a
// synthetic event performs no default action, so the helper does the one that matters: a press focusing what it hits)
// — a wheel as the browser applies one, what a rewrite or a new document must let go of, a page's stage, a claimed key,
// the clipboard, titles, and the verdict written where a headless browser's --dump-dom reads it.

import {
    Tally, check, section, Seen, collect, changesOn,
    core::println,
    ui::UiContext, ui::UiRect, ui::UiEvent, ui::UiEventKind,
    ui::UI_KEY_S, ui::UI_KEY_P, ui::UI_MOD_CTRL,
    std::collections::DynamicArray,
};
export {
    fontPath, injectClick, injectModClick, injectDoubleClick, injectKey, injectHover, injectScroll, dragBegin, dragEnd,
    typeInto, pick, legTests, pageLegTests, report,
    dropTestFiles, allowChooser, answerChooser, pasteTestFiles, spySaves, savedAs, fileLegChecks,
};

extern "kama_ui_test.h";
extern fn int32 kama_ui_test_press_at(float32 x, float32 y, int32 mods, int32 clicks);
extern fn int32 kama_ui_test_key(int32 code, int32 mods, int32 meta);
extern fn int32 kama_ui_test_hover_at(float32 x, float32 y);
extern fn int32 kama_ui_test_drag_begin(float32 from_x, float32 from_y, float32 to_x, float32 to_y);
extern fn int32 kama_ui_test_drag_end();
extern fn void  kama_ui_test_spy_clipboard();
extern fn int32 kama_ui_test_copied_is(UnsafeConstPtr<cchar> text);
extern fn int32 kama_ui_test_has_attr(UnsafeConstPtr<cchar> id, UnsafeConstPtr<cchar> attr);
extern fn void  kama_ui_test_report(int32 run, int32 failed);
extern fn int32 kama_ui_test_attr_ends(UnsafeConstPtr<cchar> id, UnsafeConstPtr<cchar> attr, UnsafeConstPtr<cchar> suffix);
extern fn int32 kama_ui_test_scroll_at(float32 x, float32 y, float32 notches);
extern fn int32 kama_ui_test_hold(UnsafeConstPtr<cchar> id);
extern fn int32 kama_ui_test_fire_held();
extern fn void  kama_ui_test_window(UnsafePtr<float32> width, UnsafePtr<float32> height);
extern fn int32 kama_ui_test_stage_is_page();
extern fn int32 kama_ui_test_type(UnsafeConstPtr<cchar> id, UnsafeConstPtr<cchar> text);
extern fn int32 kama_ui_test_pick(UnsafeConstPtr<cchar> select_id, UnsafeConstPtr<cchar> option_id);
extern fn int32 kama_ui_test_drag(UnsafeConstPtr<cchar> id, int32 steps);
extern fn int32 kama_ui_test_select(UnsafeConstPtr<cchar> id);
extern fn int32 kama_ui_test_selection_holds(UnsafeConstPtr<cchar> id);
// 0.4.0: files (kama_ui_test.h).
extern fn int32 kama_ui_test_drop_files(float32 x, float32 y, int32 how);
extern fn void  kama_ui_test_allow_chooser();
extern fn int32 kama_ui_test_chooser_is(UnsafeConstPtr<cchar> accept, int32 multiple);
extern fn int32 kama_ui_test_answer_chooser(int32 cancel);
extern fn int32 kama_ui_test_paste_files();
extern fn void  kama_ui_test_spy_saves();
extern fn int32 kama_ui_test_saved(UnsafePtr<cchar> buffer, int32 capacity);
extern fn int32 kama_ui_test_bridge_is(int32 files, int32 index, UnsafeConstPtr<cchar> name);
extern fn string kama_string_from_raw(UnsafeConstPtr<uint8> src, isize start, isize len);

// Ignored on this leg: the browser takes its faces from the page's @font-face.
fn string fontPath() { return ""; }

unsafe fn bool injectClick(ref UiContext ui, float32 x, float32 y)
{
    return kama_ui_test_press_at(x: x, y: y, mods: 0, clicks: 1) != 0;
}

unsafe fn bool injectModClick(ref UiContext ui, float32 x, float32 y, int32 mods)
{
    return kama_ui_test_press_at(x: x, y: y, mods: mods, clicks: 1) != 0;
}

unsafe fn bool injectDoubleClick(ref UiContext ui, float32 x, float32 y)
{
    return kama_ui_test_press_at(x: x, y: y, mods: 0, clicks: 2) != 0;
}

// The browser's keydown and keyup at the focused element (which a synthetic event does not act on), then the same key
// forwarded to `key`, as a page's platform layer forwards it for the ring.
unsafe fn void injectKey(ref UiContext ui, int32 code, int32 mods)
{
    kama_ui_test_key(code: code, mods: mods, meta: 0);
    ui.key(code: code, down: true, mods: mods);
    ui.key(code: code, down: false, mods: mods);
}

unsafe fn void injectHover(ref UiContext ui, float32 x, float32 y) { kama_ui_test_hover_at(x: x, y: y); }

unsafe fn void dragBegin(ref UiContext ui, float32 fromX, float32 fromY, float32 toX, float32 toY)
{
    kama_ui_test_drag_begin(from_x: fromX, from_y: fromY, to_x: toX, to_y: toY);
}

unsafe fn void dragEnd(ref UiContext ui) { kama_ui_test_drag_end(); }

unsafe fn bool keyPrevented(int32 code, int32 mods, int32 meta)
{
    return kama_ui_test_key(code: code, mods: mods, meta: meta) != 0;
}

unsafe fn void spyClipboard() { kama_ui_test_spy_clipboard(); }
unsafe fn bool copiedIs(const ref string text) { return kama_ui_test_copied_is(text: text.cstr()) != 0; }

unsafe fn bool hasAttr(const ref string id, const ref string attr)
{
    return kama_ui_test_has_attr(id: id.cstr(), attr: attr.cstr()) != 0;
}

unsafe fn bool attrEnds(const ref string id, const ref string attr, const ref string suffix)
{
    return kama_ui_test_attr_ends(id: id.cstr(), attr: attr.cstr(), suffix: suffix.cstr()) != 0;
}

// A synthetic WheelEvent scrolls nothing (the browser's own scroll is a default action of a trusted one), so the
// helper does what the browser would: it scrolls the nearest scrollable box under the point.
unsafe fn bool injectScroll(ref UiContext ui, float32 x, float32 y, float32 notches)
{
    return kama_ui_test_scroll_at(x: x, y: y, notches: notches) != 0;
}

// A browser types into its own field and reports it, so these fire what it would: an `input` per character and the
// `change` of the field letting go; the option selected, then `input` and `change`.
unsafe fn void typeInto(ref UiContext ui, const ref string id, const ref string text)
{
    kama_ui_test_type(id: id.cstr(), text: text.cstr());
}

unsafe fn void pick(ref UiContext ui, const ref string selectId, const ref string optionId)
{
    kama_ui_test_pick(select_id: selectId.cstr(), option_id: optionId.cstr());
}

unsafe fn bool drag(const ref string id, int32 steps) { return kama_ui_test_drag(id: id.cstr(), steps: steps) != 0; }

unsafe fn bool hold(const ref string id) { return kama_ui_test_hold(id: id.cstr()) != 0; }
unsafe fn bool fireHeld() { return kama_ui_test_fire_held() != 0; }
unsafe fn bool stageIsPage() { return kama_ui_test_stage_is_page() != 0; }

unsafe fn UiRect window()
{
    float32 w = 0;
    float32 h = 0;
    kama_ui_test_window(width: addr(of: w), height: addr(of: h));
    return UiRect.make(x: 0.0, y: 0.0, width: w, height: h);
}

fn void legTests(ref Tally t, ref UiContext ui, int32 first, int32 field)
{
    section(what: "web: the document is real DOM");
    check(t: t, ok: ui.commandCount() == 0 && ui.textureCount() == 0, what: "the browser paints: no commands, no textures");
    check(t: t, ok: attrEnds(id: "pic", attr: "src", suffix: "/img/dot.webp"),
          what: "setImageRewrite turned the document's /img/dot.pam into /img/dot.webp before the browser fetched it");
    check(t: t, ok: attrEnds(id: "first", attr: "id", suffix: "first"), what: "the bound button is an element with its id");

    section(what: "web: a claimed key's default is prevented, as it goes down");
    check(t: t, ok: keyPrevented(code: UI_KEY_S, mods: UI_MOD_CTRL, meta: 0), what: "Ctrl+S, claimed: prevented");
    check(t: t, ok: !keyPrevented(code: UI_KEY_P, mods: UI_MOD_CTRL, meta: 0), what: "Ctrl+P, unclaimed: not");
    collect(ui: ui);
    check(t: t, ok: keyPrevented(code: UI_KEY_S, mods: 0, meta: 1), what: "Cmd+S is Ctrl+S: prevented too");
    Optional<UiEvent> cmd = ui.pollEvent();
    bool folded = match (cmd) { case None: false; case Some(value: e): e.key == UI_KEY_S && e.mods == UI_MOD_CTRL; };
    check(t: t, ok: folded, what: "...and its Key event says Ctrl");
    collect(ui: ui);

    section(what: "web: the clipboard is the browser's");
    spyClipboard();
    ui.copyText(text: "a copy");
    check(t: t, ok: copiedIs(text: "a copy"), what: "copyText hands the text to navigator.clipboard");
    Optional<string> none = ui.takeClipboardWrite();
    bool empty = match (none) { case None: true; case Some(value: s): false; };
    check(t: t, ok: empty, what: "...and nothing is left for the program to take");

    section(what: "web: attributes");
    int32 pic = ui.bindElement(elementId: "pic");
    ui.setElementAttribute(handle: pic, name: "src", value: "/img/dot2.pam");
    check(t: t, ok: attrEnds(id: "pic", attr: "src", suffix: "/img/dot2.webp"), what: "an `src` written as an attribute is rewritten too");

    section(what: "web: a slider's release is no edit");
    int32 level = ui.bindElement(elementId: "level");
    collect(ui: ui);
    check(t: t, ok: drag(id: "level", steps: 2), what: "the range is dragged two steps and let go");
    int32 dragged = changesOn(ui: ui, handle: level);
    check(t: t, ok: dragged == 2, what: "...two changes, live, and none for the release (${dragged})");

    section(what: "web: what a rewrite or a new document lets go of hears nothing");
    int32 list = ui.bindElement(elementId: "list");
    int32 rowB = ui.bindElement(elementId: "row-b");
    check(t: t, ok: rowB > 0 && hold(id: "row-b"), what: "a bound row is held");
    ui.setInnerRml(handle: list, rml: "<div id='row-c'><p>Gamma</p></div>");
    collect(ui: ui);
    fireHeld();
    Seen afterRewrite = collect(ui: ui);
    check(t: t, ok: afterRewrite.count == 0, what: "a row a rewrite released keeps no listener (${afterRewrite.count} events)");
    check(t: t, ok: hold(id: "field"), what: "the text field is held");
    ui.closeDocument();
    fireHeld();
    Seen afterClose = collect(ui: ui);
    check(t: t, ok: afterClose.count == 0,
          what: "a field from a closed document keeps none of its click, input and change listeners (${afterClose.count})");
    // The suite closes the document next, so it has to be there.
    ui.loadDocument(path: "tests/fixtures/seam.rml");
}

unsafe fn bool selectText(const ref string id) { return kama_ui_test_select(id: id.cstr()) != 0; }
unsafe fn bool selectionHolds(const ref string id) { return kama_ui_test_selection_holds(id: id.cstr()) != 0; }

fn void pageLegTests(ref Tally t, ref UiContext ui, int32 page)
{
    section(what: "web: a title is the package's tooltip, never the browser's");
    check(t: t, ok: !hasAttr(id: "bar", attr: "title") && hasAttr(id: "bar", attr: "data-kama-ui-title"),
          what: "the bar's title is held as data-kama-ui-title, so the browser shows no popup of its own");

    section(what: "web: an append leaves a person's selection alone");
    int32 log = ui.findElement(elementId: "log");
    check(t: t, ok: selectText(id: "newest"), what: "a line's text is selected");
    ui.appendInnerRml(handle: log, rml: "<p>appended under a selection</p>");
    check(t: t, ok: selectionHolds(id: "newest"), what: "...and after an append it still is: the same nodes, still in the page");

    section(what: "web: a page's stage is the window");
    check(t: t, ok: stageIsPage(), what: "#ui-stage is pinned to the window's edges, unscaled and shown, so CSS follows a resize");
    UiRect win = window();
    UiRect pr = ui.elementRect(handle: page);
    check(t: t, ok: pr.width == win.width && pr.height == win.height,
          what: "the page fills the window (${pr.width} x ${pr.height} of ${win.width} x ${win.height})");
    ui.setViewport(offsetX: 50.0, offsetY: 50.0, scale: 2.0, visible: false);
    UiRect hidden = ui.elementRect(handle: page);
    check(t: t, ok: hidden.width == 0.0, what: "setViewport(visible: false) hides it");
    ui.setViewport(offsetX: 50.0, offsetY: 50.0, scale: 2.0, visible: true);
    UiRect again = ui.elementRect(handle: page);
    check(t: t, ok: again.x == 0.0 && again.width == pr.width && stageIsPage(),
          what: "...and true shows it again, neither moved nor scaled (x ${again.x}, ${again.width} wide)");
}

// ---- files (0.4.0): the events a browser fires, with `File`s in them ----

// Two files, a.txt ("alpha") and b.png ("PNG!"), dragged in from outside and dropped at the point: dragenter, dragover,
// drop (`how` 2). `how` 1 stops after the dragover, 3 leaves the window again, 4 drops plain text instead.
unsafe fn bool dropTestFiles(ref UiContext ui, float32 x, float32 y)
{
    return kama_ui_test_drop_files(x: x, y: y, how: 2) != 0;
}

// A synthetic click is no gesture, so the test says there was one (`navigator.userActivation`).
unsafe fn void allowChooser() { kama_ui_test_allow_chooser(); }

// The chooser waiting, as it was asked (its `<input type=file>`), answered with the two files or cancelled.
unsafe fn bool answerChooser(ref UiContext ui, int32 files, const ref string accept, bool multiple, bool cancel)
{
    int32 many = 0;
    if (multiple) { many = 1; }
    if (kama_ui_test_chooser_is(accept: accept.cstr(), multiple: many) == 0) { return false; }
    int32 c = 0;
    if (cancel) { c = 1; }
    return kama_ui_test_answer_chooser(cancel: c) != 0;
}

unsafe fn bool pasteTestFiles(ref UiContext ui) { return kama_ui_test_paste_files() != 0; }

unsafe fn void spySaves() { kama_ui_test_spy_saves(); }

// The download the spy stopped: "name size type".
unsafe fn string savedAs(ref UiContext ui)
{
    int32 n = kama_ui_test_saved(buffer: null, capacity: 0);
    if (n <= 0) { return "(none)"; }
    DynamicArray<uint8> buf = DynamicArray.empty();
    isize i = 0;
    while (i <= cast<isize>(n)) {
        buf.add(item: 0ui8);
        i = i + 1;
    }
    kama_ui_test_saved(buffer: cast<UnsafePtr<cchar>>(buf.dataPtrMut()), capacity: n + 1);
    return kama_string_from_raw(src: buf.dataPtr(), start: 0, len: cast<isize>(n));
}

// What only this leg has: no path; the zone highlighted while files are dragged over the page, and not once they
// leave; the bridge another library takes a `File` from; text dragged in from outside is no drop. The reads begun
// before settle only once the page has the event loop back, so polling here takes none of theirs.
unsafe fn void fileLegChecks(ref Tally t, ref UiContext ui, int32 list, int32 zone, float32 x, float32 y)
{
    section(what: "web: a file has no path");
    check(t: t, ok: ui.filePath(files: list, index: 0).isEmpty(), what: "filePath is empty: a page never learns one");

    section(what: "web: files dragged over the page");
    check(t: t, ok: kama_ui_test_drop_files(x: x, y: y, how: 1) != 0, what: "two files are dragged over the zone's top row");
    UiRect over = ui.elementRect(handle: zone);
    check(t: t, ok: over.width == 310.0, what: "...and the zone has `ui-drop-target` (${over.width})");
    check(t: t, ok: kama_ui_test_drop_files(x: x, y: y, how: 3) != 0, what: "they leave the window");
    UiRect left = ui.elementRect(handle: zone);
    check(t: t, ok: left.width == 300.0, what: "...and the class is gone (${left.width})");

    section(what: "web: the bridge to another library");
    check(t: t, ok: kama_ui_test_bridge_is(files: list, index: 1, name: "b.png".cstr()) != 0 &&
                    kama_ui_test_bridge_is(files: list, index: 2, name: "".cstr()) != 0,
          what: "Module.kamaUiFile hands over the listed File itself, and null outside the list");

    section(what: "web: text dragged in is no drop");
    check(t: t, ok: kama_ui_test_drop_files(x: x, y: y, how: 4) != 0, what: "text is dropped on the zone");
    int32 drops = 0;
    bool more = true;
    while (more) {
        Optional<UiEvent> e = ui.pollEvent();
        match (e) {
            case None: { more = false; }
            case Some(value: ev): {
                bool d = match (ev.kind) { case Drop: true; case _: false; };
                if (d) { drops = drops + 1; }
            }
        };
    }
    check(t: t, ok: drops == 0, what: "...and nothing reaches the program (${drops})");
}

unsafe fn int32 report(ref Tally t)
{
    int32 code = 0;
    if (t.failed != 0) {
        println(s: "ui tests (web): ${t.failed} of ${t.run} failed");
        code = 1;
    } else {
        println(s: "ui tests (web): OK, ${t.run} checks");
    }
    // Last, so what the page sends back includes every line printed above it.
    kama_ui_test_report(run: t.run, failed: t.failed);
    return code;
}
