file @compileFor(!ARCH_WASM32);
// The native leg's half of the suite: how input is injected (RmlUi's own: the pointer, its buttons and wheel, keys), the
// font, the verdict, and the checks only this leg can make — the recorded commands and textures, typing, the first-press
// focus rule, the clipboard the program bridges, and a page sized by `setSize`.

import {
    Tally, check, section, Seen, collect, press,
    core::println, core::envOr,
    ui::UiContext, ui::UiCommand, ui::UiCommandKind, ui::UiTexture, ui::UiRect, ui::uiFileType,
    ui::UI_KEY_DOWN, ui::UI_KEY_BACKSPACE, ui::UI_KEY_HOME, ui::UI_KEY_DELETE, ui::UI_KEY_A, ui::UI_KEY_C,
    ui::UI_KEY_V, ui::UI_MOD_CTRL,
    std::collections::DynamicArray,
    std::fs::writeText, std::fs::createDirAll, std::fs::remove, std::io::IoError,
    std::process::currentProcessId,
};
export {
    fontPath, injectClick, injectModClick, injectDoubleClick, injectKey, injectHover, injectScroll, dragBegin, dragEnd,
    typeInto, pick, legTests, pageLegTests, report,
    dropTestFiles, allowChooser, answerChooser, pasteTestFiles, spySaves, savedAs, fileLegChecks, playsMedia,
};

// (0.5.0) RmlUi decodes no media: a `<video>` here is a plain element (host.kama, "media").
fn bool playsMedia() { return false; }

// RmlUi's sample face, LatoLatin (SIL OFL 1.1), committed under tests/fonts/ with its licence (tests/fonts/SOURCES).
// Paths are relative to the package root, where tools/test.sh runs.
fn string fontPath() { return "tests/fonts/LatoLatin-Regular.ttf"; }

// Half a second and more of RmlUi's clock, so the next press never pairs with the last into a double click.
fn void apart(ref UiContext ui)
{
    int32 i = 0;
    while (i < 31) {
        ui.update();
        i = i + 1;
    }
}

// A click as a person makes one, on its own: time apart from the last, the pointer to the point, the left button down
// and up with the modifiers held, then the update that dispatches. True: there is no page to miss.
fn bool injectClick(ref UiContext ui, float32 x, float32 y) { return injectModClick(ui: ui, x: x, y: y, mods: 0); }

fn bool injectModClick(ref UiContext ui, float32 x, float32 y, int32 mods)
{
    apart(ui: ui);
    ui.mouseMove(x: x, y: y);
    ui.mouseButton(button: 0, down: true, mods: mods);
    ui.mouseButton(button: 0, down: false, mods: mods);
    ui.update();
    return true;
}

// Two clicks within RmlUi's half second: Click, DoubleClick (on the second press), Click.
fn bool injectDoubleClick(ref UiContext ui, float32 x, float32 y)
{
    apart(ui: ui);
    ui.mouseMove(x: x, y: y);
    ui.mouseButton(button: 0, down: true, mods: 0);
    ui.mouseButton(button: 0, down: false, mods: 0);
    ui.update();
    ui.mouseButton(button: 0, down: true, mods: 0);
    ui.mouseButton(button: 0, down: false, mods: 0);
    ui.update();
    return true;
}

// A key as a person presses it, down and up with its modifiers: what the program forwards (host.kama).
fn void injectKey(ref UiContext ui, int32 code, int32 mods)
{
    ui.key(code: code, down: true, mods: mods);
    ui.key(code: code, down: false, mods: mods);
}

// The pointer over a point; RmlUi takes the hover at once.
fn void injectHover(ref UiContext ui, float32 x, float32 y) { ui.mouseMove(x: x, y: y); }

// A drag as a person makes one, not yet let go: a press on the source, a move off it (which starts RmlUi's drag), then
// steps over to the target, each laid out.
fn void dragBegin(ref UiContext ui, float32 fromX, float32 fromY, float32 toX, float32 toY)
{
    apart(ui: ui);
    ui.mouseMove(x: fromX, y: fromY);
    ui.update();
    ui.mouseButton(button: 0, down: true, mods: 0);
    ui.update();
    int32 step = 1;
    while (step <= 4) {
        float32 f = cast<float32>(step) / 4.0;
        ui.mouseMove(x: fromX + (toX - fromX) * f + 1.0, y: fromY + (toY - fromY) * f);
        ui.update();
        step = step + 1;
    }
}

// ...and let go.
fn void dragEnd(ref UiContext ui)
{
    ui.mouseButton(button: 0, down: false, mods: 0);
    ui.update();
}

// The wheel as a person turns it: the pointer over the point first (it decides what scrolls), then the notches, then a
// second of updates, since RmlUi scrolls smoothly. True: there is no page to miss.
fn bool injectScroll(ref UiContext ui, float32 x, float32 y, float32 notches)
{
    ui.mouseMove(x: x, y: y);
    ui.update();
    ui.mouseWheel(delta: notches);
    int32 i = 0;
    while (i < 60) {
        ui.update();
        i = i + 1;
    }
    return true;
}

// Typing as a person does: the ring on the control (found, so nothing new listens), then each character, then the
// update that lays it out.
fn void typeInto(ref UiContext ui, const ref string id, const ref string text)
{
    int32 h = ui.findElement(elementId: id);
    ui.focusElement(handle: h);
    foreach (char c in text.chars()) { ui.typeChar(codepoint: cast<int32>(c)); }
    ui.update();
}

// Choosing as a person does: a click opens the select, a second lands on the option in the box it opened.
fn void pick(ref UiContext ui, const ref string selectId, const ref string optionId)
{
    int32 s = ui.findElement(elementId: selectId);
    UiRect sr = ui.elementRect(handle: s);
    injectClick(ui: ui, x: sr.x + sr.width * 0.5, y: sr.y + sr.height * 0.5);
    ui.update();
    int32 o = ui.findElement(elementId: optionId);
    UiRect optionBox = ui.elementRect(handle: o);
    injectClick(ui: ui, x: optionBox.x + optionBox.width * 0.5, y: optionBox.y + optionBox.height * 0.5);
}

fn void legTests(ref Tally t, ref UiContext ui, int32 first, int32 field)
{
    section(what: "native: the recorded commands and textures");
    ui.update();
    ui.render();
    int32 count = ui.commandCount();
    int32 draws = 0;
    int32 textured = 0;
    int32 verts = 0;
    int32 i = 0;
    while (i < count) {
        UiCommand c = ui.command(index: i);
        bool draw = match (c.kind) { case Draw: true; case _: false; };
        if (draw) {
            draws = draws + 1;
            verts = verts + c.vertexCount;
            if (c.texture != 0) { textured = textured + 1; }
        }
        i = i + 1;
    }
    check(t: t, ok: draws > 5 && verts > 0, what: "the document records draws (${draws} draws, ${verts} vertices)");
    check(t: t, ok: textured > 0, what: "text is drawn from a texture (${textured} textured draws)");
    int32 textures = ui.textureCount();
    check(t: t, ok: textures >= 2, what: "a glyph atlas and the provided picture are textures (${textures})");
    UiTexture tex = ui.texture(handle: 1);
    check(t: t, ok: tex.width > 0 && tex.height > 0 && ui.textureGeneration(handle: 1) >= 1,
          what: "texture 1 has a size and a generation (${tex.width} x ${tex.height})");
    int32 pic = ui.bindElement(elementId: "pic");
    UiRect pr = ui.elementRect(handle: pic);
    check(t: t, ok: pr.width == 2.0 && pr.height == 2.0, what: "the provided picture lays out at its own size (${pr.width} x ${pr.height})");
    UiCommand outside = ui.command(index: count + 3);
    check(t: t, ok: outside.vertexCount == 0, what: "an out-of-range command is empty");

    section(what: "native: typing into the text field");
    check(t: t, ok: ui.focusElement(handle: field) && ui.textFocused(), what: "the field takes the ring");
    ui.setElementText(handle: field, text: "");
    string typed = "10.0.0.7:270159";
    foreach (char c in typed.chars()) { ui.typeChar(codepoint: cast<int32>(c)); }
    ui.update();
    press(ui: ui, key: UI_KEY_BACKSPACE);
    string v1 = ui.elementText(handle: field);
    check(t: t, ok: v1 == "10.0.0.7:27015", what: "typed, and Backspace takes one back ('${v1}')");
    press(ui: ui, key: UI_KEY_HOME);
    press(ui: ui, key: UI_KEY_DELETE);
    string v2 = ui.elementText(handle: field);
    check(t: t, ok: v2 == "0.0.0.7:27015", what: "Home then Delete edits at the caret ('${v2}')");
    Seen typing = collect(ui: ui);
    check(t: t, ok: typing.changes >= 1, what: "a person's typing raises change events (${typing.changes})");

    section(what: "native: a navigation key with nothing focused lands on the first control");
    ui.focusDocument();
    ui.update();
    check(t: t, ok: ui.focusedElement() == 0 && !ui.focusHeld(), what: "the document alone holds no ring");
    press(ui: ui, key: UI_KEY_DOWN);
    check(t: t, ok: ui.focusedElement() == first, what: "...and the first arrow lands on the first button");

    section(what: "native: the clipboard is the program's to bridge");
    ui.copyText(text: "a copy");
    Optional<string> copied = ui.takeClipboardWrite();
    string copiedText = match (copied) { case None: "(none)"; case Some(value: s): copy s; };
    Optional<string> nothing = ui.takeClipboardWrite();
    bool drained = match (nothing) { case None: true; case Some(value: s): false; };
    check(t: t, ok: copiedText == "a copy" && drained, what: "copyText queues one write for the OS clipboard ('${copiedText}')");
    ui.setElementText(handle: field, text: "all of it");
    check(t: t, ok: ui.focusElement(handle: field), what: "the field takes the ring");
    injectKey(ui: ui, code: UI_KEY_A, mods: UI_MOD_CTRL);
    injectKey(ui: ui, code: UI_KEY_C, mods: UI_MOD_CTRL);
    ui.update();
    Optional<string> fromField = ui.takeClipboardWrite();
    string fieldCopy = match (fromField) { case None: "(none)"; case Some(value: s): copy s; };
    check(t: t, ok: fieldCopy == "all of it", what: "Ctrl+A, Ctrl+C in a field queues its text ('${fieldCopy}')");
    ui.setElementText(handle: field, text: "");
    ui.provideClipboard(text: "pasted");
    injectKey(ui: ui, code: UI_KEY_V, mods: UI_MOD_CTRL);
    ui.update();
    string pasted = ui.elementText(handle: field);
    check(t: t, ok: pasted == "pasted", what: "...and Ctrl+V pastes what the program provided ('${pasted}')");
    ui.setElementText(handle: field, text: "");
    collect(ui: ui);
}

fn void pageLegTests(ref Tally t, ref UiContext ui, int32 page)
{
    section(what: "native: a page is the size setSize gives it");
    UiRect opened = ui.elementRect(handle: page);
    check(t: t, ok: opened.width == 800.0 && opened.height == 600.0,
          what: "it fills the 800 x 600 it opened at (${opened.width} x ${opened.height})");
    ui.setSize(width: 1024, height: 700);
    ui.update();
    UiRect resized = ui.elementRect(handle: page);
    check(t: t, ok: resized.width == 1024.0 && resized.height == 700.0,
          what: "...and reflows to the window's new size (${resized.width} x ${resized.height})");
}

// ---- files (0.4.0): natively a file is a path, and the program forwards what its window and dialogs give it ----

// This run's folder of test files: a.txt is "alpha", b.png the four bytes "PNG!".
unsafe fn string testDir()
{
    string tmp = envOr(name: "TMPDIR", dflt: "/tmp");
    int32 pid = currentProcessId();
    return "${tmp}/kama-ui-files-${pid}";
}

unsafe fn DynamicArray<string> testPaths(bool both)
{
    string dir = testDir();
    Result<Unit, IoError> made = createDirAll(path: dir);
    string a = "${dir}/a.txt";
    string b = "${dir}/b.png";
    Result<isize, IoError> wa = writeText(path: a, text: "alpha");
    Result<isize, IoError> wb = writeText(path: b, text: "PNG!");
    DynamicArray<string> paths = DynamicArray.empty();
    paths.add(item: give a);
    if (both) { paths.add(item: copy b); }
    return paths;
}

// The window's drop, forwarded as the program forwards it.
unsafe fn bool dropTestFiles(ref UiContext ui, float32 x, float32 y)
{
    DynamicArray<string> paths = testPaths(both: true);
    ui.dropFiles(paths: paths, x: x, y: y);
    return true;
}

// Natively a chooser waits for the program, which needs no gesture.
fn void allowChooser() { }

// The program's half: the request taken once, as it was asked, then answered with the files (or none).
unsafe fn bool answerChooser(ref UiContext ui, int32 files, const ref string accept, bool multiple, bool cancel)
{
    int32 asked = ui.takeFileRequest();
    if (asked != files || ui.takeFileRequest() != 0) { return false; }
    if (ui.fileRequestAccept(files: files) != accept || ui.fileRequestMultiple(files: files) != multiple) { return false; }
    DynamicArray<string> paths = DynamicArray.empty();
    if (!cancel) { paths = testPaths(both: true); }
    ui.provideFiles(files: files, paths: paths);
    return true;
}

unsafe fn bool pasteTestFiles(ref UiContext ui)
{
    DynamicArray<string> paths = testPaths(both: false);
    ui.pasteFiles(paths: paths);
    return true;
}

fn void spySaves() { }

// What the program would write: the request's name, its bytes, and the type the name gives — taken once.
unsafe fn string savedAs(ref UiContext ui)
{
    int32 save = ui.takeSaveRequest();
    if (save == 0) { return "(none)"; }
    string name = ui.saveRequestName(save: save);
    DynamicArray<uint8> bytes = DynamicArray.empty();
    bool took = ui.saveRequestBytes(save: save, into: bytes);
    isize n = bytes.length();
    string type = uiFileType(name: name);
    if (!took || ui.takeSaveRequest() != 0) { return "(taken twice)"; }
    return "${name} ${n} ${type}";
}

// What only this leg has: a file's path; a chooser for one file keeping the first it is given; a read of a file
// gone from the disk, failing with its reason. Nothing here polls: the reads begun before are still queued.
unsafe fn void fileLegChecks(ref Tally t, ref UiContext ui, int32 list, int32 zone, float32 x, float32 y)
{
    section(what: "native: a file is its path");
    string p = ui.filePath(files: list, index: 0);
    check(t: t, ok: p.endsWith(suffix: "/a.txt") && p.startsWith(prefix: "/"), what: "filePath is the absolute path given ('${p}')");

    section(what: "native: a chooser for one file keeps the first");
    int32 one = ui.chooseFiles(accept: "", multiple: false);
    bool answered = answerChooser(ui: ui, files: one, accept: "", multiple: false, cancel: false);
    int32 kept = ui.fileCount(files: one);
    check(t: t, ok: answered && kept == 1, what: "two paths given, one kept (${kept})");
    ui.releaseFiles(files: one);

    section(what: "native: a read of a file that went away fails, saying why");
    string dir = testDir();
    string gone = "${dir}/gone.txt";
    Result<isize, IoError> w = writeText(path: gone, text: "soon gone");
    DynamicArray<string> paths = DynamicArray.empty();
    paths.add(item: copy gone);
    int32 lone = ui.chooseFiles(accept: "", multiple: false);
    int32 asked = ui.takeFileRequest();
    ui.provideFiles(files: lone, paths: paths);
    Result<Unit, IoError> rm = remove(path: gone);
    int32 r = ui.readFile(files: lone, index: 0, offset: 0, count: 4);
    DynamicArray<uint8> into = DynamicArray.empty();
    string why = ui.readError(read: r);
    bool read = ui.readBytes(read: r, into: into);
    check(t: t, ok: r != 0 && !read && into.length() == 0 && why.contains(substring: "gone.txt"),
          what: "readBytes is false and readError names the file ('${why}')");
    ui.releaseFiles(files: lone);
    check(t: t, ok: ui.takeSaveRequest() == 0, what: "with no save offered there is no save request");
}

fn int32 report(ref Tally t)
{
    if (t.failed != 0) {
        println(s: "ui tests (native): ${t.failed} of ${t.run} failed");
        return 1;
    }
    println(s: "ui tests (native): OK, ${t.run} checks");
    return 0;
}
