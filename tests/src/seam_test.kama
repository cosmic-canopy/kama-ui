// The seam, on whichever leg this build is: the SAME checks against `ui::UiContext` natively (through @kama/rmlui) and
// in a browser (through the DOM). One document (tests/fixtures/seam.rml), loaded from a file and from text; an event
// round trip from a real injected click; the focus ring walked by keys; controls written and read back; a rewrite
// re-bound; the document closed. Where the legs legitimately differ (commands, typing, the browser's own focus model),
// the check lives in leg_native.kama or leg_web.kama instead. Then a page (`openPage`), in `pageTests`.

import {
    Tally, check, section, injectClick, injectModClick, injectDoubleClick, injectKey, injectHover, injectScroll,
    dragBegin, dragEnd, typeInto, pick, fontPath, legTests, pageLegTests,
    ui::UiContext, ui::UiEvent, ui::UiEventKind, ui::UiRect,
    ui::UI_KEY_TAB, ui::UI_KEY_ENTER, ui::UI_KEY_DOWN, ui::UI_KEY_UP, ui::UI_KEY_RIGHT, ui::UI_KEY_ESCAPE,
    ui::UI_KEY_F2, ui::UI_KEY_PAGE_DOWN, ui::UI_KEY_S, ui::UI_KEY_1, ui::UI_MOD_SHIFT, ui::UI_MOD_CTRL, ui::UI_MOD_ALT,
    ui::uidoc::escapeText,
};
export { seamTests, pageTests, Seen, collect, changesOn, press, centerX, centerY };

// What the queue held of what an element did — clicks, changes, double clicks, drops — with the handles, targets,
// source and modifiers of the first two. Keys, Focus and Blur are left out: they ride along with presses (a click
// moves the focus, a press of ENTER is a key) and have checks of their own (`trace`, `keysOf`).
type value Seen {
    public int32 count;
    public int32 clicks;
    public int32 changes;
    public int32 doubles;
    public int32 drops;
    public int32 first;
    public int32 second;
    public int32 firstTarget;
    public int32 secondTarget;
    public int32 firstSource;
    public int32 firstMods;

    public ctor none()
    {
        this.count = 0;
        this.clicks = 0;
        this.changes = 0;
        this.doubles = 0;
        this.drops = 0;
        this.first = 0;
        this.second = 0;
        this.firstTarget = 0;
        this.secondTarget = 0;
        this.firstSource = 0;
        this.firstMods = 0;
    }
}

// What a press of keys gave the document: how many Key events, and the last one's key, modifiers, element and target.
type value Pressed {
    public int32 count;
    public int32 key;
    public int32 mods;
    public int32 element;
    public int32 target;

    public ctor none()
    {
        this.count = 0;
        this.key = 0;
        this.mods = 0;
        this.element = 0;
        this.target = 0;
    }
}

fn Seen collect(ref UiContext ui)
{
    Seen s = Seen.none();
    bool more = true;
    while (more) {
        Optional<UiEvent> e = ui.pollEvent();
        match (e) {
            case None: { more = false; }
            case Some(value: ev): {
                bool aside = match (ev.kind) { case Key: true; case Focus: true; case Blur: true; case _: false; };
                if (!aside) {
                    s.count = s.count + 1;
                    bool click = match (ev.kind) { case Click: true; case _: false; };
                    bool change = match (ev.kind) { case Change: true; case _: false; };
                    bool twice = match (ev.kind) { case DoubleClick: true; case _: false; };
                    bool dropped = match (ev.kind) { case Drop: true; case _: false; };
                    if (click) { s.clicks = s.clicks + 1; }
                    if (change) { s.changes = s.changes + 1; }
                    if (twice) { s.doubles = s.doubles + 1; }
                    if (dropped) { s.drops = s.drops + 1; }
                    if (s.count == 1) {
                        s.first = ev.element;
                        s.firstTarget = ev.target;
                        s.firstSource = ev.source;
                        s.firstMods = ev.mods;
                    }
                    if (s.count == 2) { s.second = ev.element; s.secondTarget = ev.target; }
                }
            }
        };
    }
    return s;
}

// Drain the queue, counting the changes one handle heard (a bound container would hear them too, as a second count).
fn int32 changesOn(ref UiContext ui, int32 handle)
{
    int32 n = 0;
    bool more = true;
    while (more) {
        Optional<UiEvent> e = ui.pollEvent();
        match (e) {
            case None: { more = false; }
            case Some(value: ev): {
                bool change = match (ev.kind) { case Change: true; case _: false; };
                if (change && ev.element == handle) { n = n + 1; }
            }
        };
    }
    return n;
}

fn Pressed keysOf(ref UiContext ui)
{
    Pressed p = Pressed.none();
    bool more = true;
    while (more) {
        Optional<UiEvent> e = ui.pollEvent();
        match (e) {
            case None: { more = false; }
            case Some(value: ev): {
                bool key = match (ev.kind) { case Key: true; case _: false; };
                if (key) {
                    p.count = p.count + 1;
                    p.key = ev.key;
                    p.mods = ev.mods;
                    p.element = ev.element;
                    p.target = ev.target;
                }
            }
        };
    }
    return p;
}

fn string kindName(UiEventKind k)
{
    return match (k) {
        case None: "None";
        case Click: "Click";
        case Change: "Change";
        case DoubleClick: "DoubleClick";
        case Key: "Key";
        case Focus: "Focus";
        case Blur: "Blur";
        case Drop: "Drop";
    };
}

// Everything the queue held but keys, in order, as "Kind:element>target" with each handle's id — one string to compare
// across the legs.
fn string trace(ref UiContext ui)
{
    string acc = "";
    bool more = true;
    while (more) {
        Optional<UiEvent> e = ui.pollEvent();
        match (e) {
            case None: { more = false; }
            case Some(value: ev): {
                bool key = match (ev.kind) { case Key: true; case _: false; };
                if (!key) {
                    string kind = kindName(k: ev.kind);
                    string element = ui.elementId(handle: ev.element);
                    string target = ui.elementId(handle: ev.target);
                    string one = "${kind}:${element}>${target}";
                    if (acc.isEmpty()) { acc = copy one; } else { acc = "${acc},${one}"; }
                }
            }
        };
    }
    return acc;
}

// The kinds one handle heard, in order, leaving out keys, focus and blur: "Click,DoubleClick,Click".
fn string kindsOn(ref UiContext ui, int32 handle)
{
    string acc = "";
    bool more = true;
    while (more) {
        Optional<UiEvent> e = ui.pollEvent();
        match (e) {
            case None: { more = false; }
            case Some(value: ev): {
                bool aside = match (ev.kind) { case Key: true; case Focus: true; case Blur: true; case _: false; };
                if (!aside && ev.element == handle) {
                    string kind = kindName(k: ev.kind);
                    if (acc.isEmpty()) { acc = copy kind; } else { acc = "${acc},${kind}"; }
                }
            }
        };
    }
    return acc;
}

// A key pressed as a person presses it (each leg's `injectKey`), then laid out.
fn void press(ref UiContext ui, int32 key)
{
    injectKey(ui: ui, code: key, mods: 0);
    ui.update();
}

fn float32 centerX(UiRect r) { return r.x + r.width * 0.5; }
fn float32 centerY(UiRect r) { return r.y + r.height * 0.5; }

fn string seamText()
{
    return "<rml><head><title>Text</title><style>
        body { font-family: LatoLatin; font-size: 20dp; color: #ffffff; width: 100%; height: 100%; }
        div, button { display: block; }
        button { width: 160dp; height: 30dp; tab-index: auto; nav: auto; }
    </style></head><body>
        <div id='box'><button id='only' autofocus>Only</button></div>
    </body></rml>";
}

// A page: a bar over a log that scrolls in its own box, the whole filling the window.
fn string pageText()
{
    return "<rml><head><title>Page</title><style>
        body { font-family: LatoLatin; font-size: 16dp; color: #ffffff; width: 100%; height: 100%; }
        div, p { display: block; }
        #page { width: 100%; height: 100%; }
        #bar { height: 40dp; }
        #log { height: 120dp; overflow: auto; }
        #log p { height: 30dp; }
        #log p.marked { margin-left: 10dp; }
        scrollbarvertical { width: 8dp; }
        scrollbarvertical sliderbar { min-height: 10dp; background-color: #808080ff; }
    </style></head><body>
        <div id='page'><div id='bar' title='The tool bar'>Tools</div><div id='log'>
            <p id='line1'>one</p><p>two</p><p>three</p><p>four</p><p>five</p><p>six</p><p>seven</p><p>eight</p>
            <p>nine</p><p>ten</p><p>eleven</p><p>twelve</p>
        </div></div>
    </body></rml>";
}

// More than 0.1.0's 511-byte web buffer held, with three-byte characters in it so a byte count cannot pass by luck.
fn string longText()
{
    string piece = "0123456789 ab€ ";
    string s = "";
    int32 i = 0;
    while (i < 200) {
        s = "${s}${piece}";
        i = i + 1;
    }
    return s;
}

fn void seamTests(ref Tally t)
{
    section(what: "the seam: open, a document from a file, bound elements");
    string font = fontPath();
    UiContext ui = UiContext.open(width: 1280, height: 720, fontPath: font);
    check(t: t, ok: ui.isOpen(), what: "the UI opens");
    if (!ui.isOpen()) { return; }
    ui.setDpRatio(ratio: 1.0);
    ui.setViewport(offsetX: 0.0, offsetY: 0.0, scale: 1.0, visible: true);
    // Natively the picture is the bytes below; on the web the browser fetches /img/dot.webp itself.
    ui.setImageRewrite(nativeExt: ".pam", webExt: ".webp");
    InlineArray<uint8>#(16) pixels = [255ui8, 0ui8, 0ui8, 255ui8, 0ui8, 255ui8, 0ui8, 255ui8,
                                      0ui8, 0ui8, 255ui8, 255ui8, 255ui8, 255ui8, 255ui8, 255ui8];
    ui.provideImage(name: "img/dot.pam", rgba: pixels.view(), width: 2, height: 2);

    check(t: t, ok: ui.loadDocument(path: "tests/fixtures/seam.rml"), what: "a document loads from a file");
    int32 first = ui.bindElement(elementId: "first");
    int32 second = ui.bindElement(elementId: "second");
    int32 field = ui.bindElement(elementId: "field");
    int32 last = ui.bindElement(elementId: "last");
    int32 panel = ui.bindElement(elementId: "panel");
    int32 rows = ui.bindElement(elementId: "rows");
    int32 meter = ui.bindElement(elementId: "meter");
    int32 level = ui.bindElement(elementId: "level");
    check(t: t, ok: first > 0 && second > 0 && field > 0 && last > 0 && panel > 0 && rows > 0 && meter > 0 && level > 0,
          what: "every id binds to a handle");
    check(t: t, ok: ui.bindElement(elementId: "no-such-id") == 0, what: "an unknown id binds to 0");
    check(t: t, ok: ui.bindElement(elementId: "first") == first, what: "binding an id again gives the same handle");
    ui.update();
    ui.render();
    UiRect fr = ui.elementRect(handle: first);
    check(t: t, ok: fr.width == 200.0 && fr.height == 32.0, what: "a bound button has its laid-out box (${fr.width} x ${fr.height})");

    section(what: "the seam: the focus ring");
    check(t: t, ok: ui.focusedElement() == first && ui.focusHeld(), what: "the ring starts on the autofocus button");
    press(ui: ui, key: UI_KEY_DOWN);
    check(t: t, ok: ui.focusedElement() == second, what: "down: second");
    press(ui: ui, key: UI_KEY_DOWN);
    check(t: t, ok: ui.focusedElement() == field && ui.textFocused(), what: "down: the text field, and it is a text field");
    press(ui: ui, key: UI_KEY_DOWN);
    check(t: t, ok: ui.focusedElement() == last && !ui.textFocused(), what: "down: last, no longer in a text field");
    press(ui: ui, key: UI_KEY_DOWN);
    check(t: t, ok: ui.focusedElement() == first, what: "down from last wraps to first");
    press(ui: ui, key: UI_KEY_UP);
    check(t: t, ok: ui.focusedElement() == last, what: "up from first wraps to last");
    press(ui: ui, key: UI_KEY_TAB);
    int32 afterTab = ui.focusedElement();
    check(t: t, ok: afterTab == first, what: "TAB walks the same ring (on ${afterTab}; first ${first}, second ${second}, field ${field}, last ${last})");
    check(t: t, ok: ui.focusElement(handle: second) && ui.focusedElement() == second, what: "focusElement puts the ring on second");
    collect(ui: ui);
    press(ui: ui, key: UI_KEY_ENTER);
    Seen entered = collect(ui: ui);
    check(t: t, ok: entered.clicks == 2 && entered.first == second && entered.second == panel,
          what: "ENTER clicks the focused button: second's click, then the panel's as it bubbles (${entered.clicks} clicks)");
    check(t: t, ok: entered.firstTarget == second && entered.secondTarget == second,
          what: "...and both name second as the target (${entered.firstTarget}, ${entered.secondTarget})");

    section(what: "the seam: a real click, injected, comes back as an event");
    UiRect lr = ui.elementRect(handle: last);
    check(t: t, ok: injectClick(ui: ui, x: centerX(r: lr), y: centerY(r: lr)), what: "a click is injected at last's box");
    Seen clicked = collect(ui: ui);
    check(t: t, ok: clicked.clicks == 2 && clicked.first == last && clicked.second == panel,
          what: "...and arrives as last's click, then the panel's (${clicked.clicks} clicks, first ${clicked.first})");
    check(t: t, ok: clicked.secondTarget == last, what: "...the panel's naming last as its target (${clicked.secondTarget})");
    UiRect mr = ui.elementRect(handle: meter);
    injectClick(ui: ui, x: centerX(r: mr), y: centerY(r: mr));
    Seen bare = collect(ui: ui);
    check(t: t, ok: bare.clicks == 1 && bare.first == meter && bare.firstTarget == meter,
          what: "a click outside the panel reaches only what was hit, which is its own target");

    section(what: "the seam: controls written and read, quietly");
    string hello = "hello, seam";
    ui.setElementText(handle: field, text: hello);
    string got = ui.elementText(handle: field);
    check(t: t, ok: got == hello, what: "a text field's value reads back ('${got}')");
    ui.setElementValue(handle: level, value: 0.25);
    float32 lv = ui.elementValue(handle: level);
    check(t: t, ok: lv > 0.249 && lv < 0.251, what: "a range's value reads back (${lv})");
    Seen quiet = collect(ui: ui);
    check(t: t, ok: quiet.count == 0, what: "...and neither write raised an event (${quiet.count})");
    check(t: t, ok: ui.elementValue(handle: meter) == 0.0, what: "a non-control's value is 0");

    section(what: "the seam: classes and inline properties");
    ui.setElementClass(handle: meter, name: "wide", on: true);
    ui.update();
    UiRect wide = ui.elementRect(handle: meter);
    check(t: t, ok: wide.width == 300.0, what: "a class switches a document rule on (${wide.width} wide)");
    check(t: t, ok: ui.setElementProperty(handle: meter, name: "width", value: "150dp"), what: "an inline property in dp is taken");
    ui.update();
    UiRect narrow = ui.elementRect(handle: meter);
    check(t: t, ok: narrow.width == 150.0, what: "...and wins over the class (${narrow.width} wide)");
    ui.setElementProperty(handle: meter, name: "width", value: "");
    ui.setElementClass(handle: meter, name: "wide", on: false);
    ui.update();
    UiRect back = ui.elementRect(handle: meter);
    check(t: t, ok: back.width == 100.0, what: "removing both puts the document's width back (${back.width})");

    section(what: "the seam: a rewrite, and re-binding what it wrote");
    int32 row0 = ui.bindElement(elementId: "row0");
    int32 row1 = ui.bindElement(elementId: "row1");
    string escaped = escapeText(raw: "<b>Sam</b> & co");
    string rowsRml = "<p id='row1'>x</p><p id='row2'>${escaped}</p>";
    ui.setInnerRml(handle: rows, rml: rowsRml);
    ui.update();
    int32 row2 = ui.bindElement(elementId: "row2");
    int32 row1again = ui.bindElement(elementId: "row1");
    check(t: t, ok: row2 > 0 && row1again == row1, what: "after a rewrite a new id binds and an old one keeps its handle");
    UiRect r2 = ui.elementRect(handle: row2);
    check(t: t, ok: r2.height > 0.0, what: "...and the new row has a box (${r2.height} high)");
    check(t: t, ok: ui.bindElement(elementId: "rows") == rows, what: "...and the container's own handle never moved");

    section(what: "the seam: a rewrite releases what it replaced");
    // row0 was bound before the rewrite above, which did not write it back. Natively this runs under AddressSanitizer.
    UiRect gone = ui.elementRect(handle: row0);
    check(t: t, ok: gone.width == 0.0 && gone.height == 0.0, what: "a handle into what a rewrite replaced has no box");
    string goneText = ui.elementText(handle: row0);
    ui.setElementText(handle: row0, text: "x");
    ui.setElementValue(handle: row0, value: 1.0);
    ui.setElementClass(handle: row0, name: "wide", on: true);
    ui.setElementAttribute(handle: row0, name: "hidden", value: "");
    ui.removeElementAttribute(handle: row0, name: "hidden");
    ui.setInnerRml(handle: row0, rml: "<p>x</p>");
    ui.update();
    check(t: t, ok: goneText == "" && ui.elementValue(handle: row0) == 0.0 && !ui.elementChecked(handle: row0) &&
                    !ui.focusElement(handle: row0) && !ui.setElementProperty(handle: row0, name: "width", value: "10dp"),
          what: "...every call on it is a no-op");
    string goneId = ui.elementId(handle: row0);
    check(t: t, ok: goneId == "row0", what: "...it keeps its id ('${goneId}')");
    Seen released = collect(ui: ui);
    check(t: t, ok: released.count == 0, what: "...and nothing it did raised an event (${released.count})");
    ui.setInnerRml(handle: rows, rml: "<p id='row0'>back</p>");
    ui.update();
    UiRect back0 = ui.elementRect(handle: row0);
    check(t: t, ok: back0.height > 0.0 && ui.bindElement(elementId: "row0") == row0,
          what: "...until its id is back: then the same handle names the new element (${back0.height} high)");

    section(what: "the seam: one binding on a list tells its rows apart");
    int32 list = ui.bindElement(elementId: "list");
    UiRect lb = ui.elementRect(handle: list);
    // Rows 24 high under 6 of padding (seam.rml), so a point lands on a row by arithmetic, with no row bound.
    float32 rowX = lb.x + 40.0;
    injectClick(ui: ui, x: rowX, y: lb.y + 18.0);
    Seen onA = collect(ui: ui);
    string aId = ui.elementId(handle: onA.firstTarget);
    check(t: t, ok: onA.count == 1 && onA.first == list && aId == "row-a-name",
          what: "a click on the first row is the list's, naming the row's text by its own id ('${aId}')");
    injectClick(ui: ui, x: rowX, y: lb.y + 42.0);
    Seen onB = collect(ui: ui);
    string bId = ui.elementId(handle: onB.firstTarget);
    check(t: t, ok: onB.count == 1 && onB.first == list && bId == "row-b",
          what: "...on the second, whose text has no id, it names the row ('${bId}')");
    injectClick(ui: ui, x: rowX, y: lb.y + 42.0);
    Seen onB2 = collect(ui: ui);
    check(t: t, ok: onB2.count == 1 && onB2.firstTarget == onB.firstTarget,
          what: "...again: the same handle, and naming a target listens to nothing (${onB2.count} events)");
    injectClick(ui: ui, x: rowX, y: lb.y + 2.0);
    Seen onList = collect(ui: ui);
    check(t: t, ok: onList.count == 1 && onList.firstTarget == list, what: "a click on the list's own padding names the list");
    check(t: t, ok: ui.bindElement(elementId: "row-a-name") == onA.firstTarget,
          what: "a target is the handle bindElement gives for its id");
    injectClick(ui: ui, x: rowX, y: lb.y + 18.0);
    Seen onBound = collect(ui: ui);
    check(t: t, ok: onBound.count == 2 && onBound.first == onA.firstTarget && onBound.second == list &&
                    onBound.secondTarget == onA.firstTarget,
          what: "...and once bound it hears its own click, the list's still naming it (${onBound.count} events)");
    check(t: t, ok: ui.elementId(handle: 0) == "" && ui.elementId(handle: 9999) == "", what: "an unknown handle has no id");

    section(what: "the seam: an element named without listening");
    int32 heading = ui.findElement(elementId: "title");
    UiRect hr = ui.elementRect(handle: heading);
    check(t: t, ok: heading > 0 && hr.height > 0.0, what: "findElement names an element, and its box reads back (${hr.height} high)");
    injectClick(ui: ui, x: centerX(r: hr), y: centerY(r: hr));
    Seen onHeading = collect(ui: ui);
    check(t: t, ok: onHeading.count == 0, what: "...a click on it raises nothing (${onHeading.count})");
    int32 rowA = ui.findElement(elementId: "row-a");
    injectClick(ui: ui, x: rowX, y: lb.y + 18.0);
    Seen onRowA = collect(ui: ui);
    check(t: t, ok: onRowA.count == 2 && onRowA.first != rowA && onRowA.second != rowA,
          what: "a found container hears nothing of its children: the bound text's click and the list's only (${onRowA.count})");
    check(t: t, ok: ui.findElement(elementId: "list") == list && ui.findElement(elementId: "no-such-id") == 0 &&
                    ui.findElement(elementId: "") == 0,
          what: "findElement gives a bound id's own handle, and 0 for no element");
    UiRect listFull = ui.elementRect(handle: list);
    ui.setElementAttribute(handle: rowA, name: "hidden", value: "");
    ui.update();
    UiRect listShort = ui.elementRect(handle: list);
    ui.removeElementAttribute(handle: rowA, name: "hidden");
    check(t: t, ok: listShort.height < listFull.height, what: "...and a found handle takes a write (${listFull.height} -> ${listShort.height})");
    int32 aName = ui.bindElement(elementId: "row-a-name");
    ui.setInnerRml(handle: rowA, rml: "<p id='row-a-name'>Alpha, again</p>");
    ui.update();
    string rowAId = ui.elementId(handle: rowA);
    check(t: t, ok: rowAId == "row-a" && ui.bindElement(elementId: "row-a-name") == aName,
          what: "...and a rewrite, after which what it wrote re-binds ('${rowAId}')");
    check(t: t, ok: ui.bindElement(elementId: "title") == heading, what: "binding a found id gives the same handle");
    injectClick(ui: ui, x: centerX(r: hr), y: centerY(r: hr));
    Seen onBoundHeading = collect(ui: ui);
    check(t: t, ok: onBoundHeading.count == 1 && onBoundHeading.first == heading, what: "...which now hears its clicks");

    section(what: "the seam: attributes, and a checkbox's state");
    int32 note = ui.bindElement(elementId: "note");
    int32 agree = ui.bindElement(elementId: "agree");
    UiRect shown = ui.elementRect(handle: list);
    ui.setElementAttribute(handle: note, name: "hidden", value: "");
    ui.update();
    UiRect hid = ui.elementRect(handle: list);
    check(t: t, ok: hid.y < shown.y, what: "`hidden` and the document's [hidden] rule take the note out (${shown.y} -> ${hid.y})");
    ui.removeElementAttribute(handle: note, name: "hidden");
    ui.update();
    UiRect unhid = ui.elementRect(handle: list);
    check(t: t, ok: unhid.y == shown.y, what: "...and removing it puts it back (${unhid.y})");
    check(t: t, ok: !ui.elementChecked(handle: agree), what: "a checkbox starts unchecked");
    ui.setElementAttribute(handle: agree, name: "checked", value: "");
    check(t: t, ok: ui.elementChecked(handle: agree), what: "writing `checked` checks it");
    ui.removeElementAttribute(handle: agree, name: "checked");
    check(t: t, ok: !ui.elementChecked(handle: agree), what: "...and removing it unchecks it");
    Seen quietChecks = collect(ui: ui);
    check(t: t, ok: quietChecks.count == 0, what: "...and neither write raised an event (${quietChecks.count})");
    UiRect ar = ui.elementRect(handle: agree);
    injectClick(ui: ui, x: centerX(r: ar), y: centerY(r: ar));
    Seen toggled = collect(ui: ui);
    check(t: t, ok: ui.elementChecked(handle: agree) && toggled.clicks == 1 && toggled.changes >= 1 && toggled.firstTarget == agree,
          what: "a person's click checks it: a click and a change, naming the box (${toggled.clicks}, ${toggled.changes})");
    injectClick(ui: ui, x: centerX(r: ar), y: centerY(r: ar));
    collect(ui: ui);
    check(t: t, ok: !ui.elementChecked(handle: agree), what: "...and a second click unchecks it");
    ui.setElementAttribute(handle: agree, name: "checked", value: "");
    check(t: t, ok: ui.elementChecked(handle: agree), what: "a write after a person's toggle still checks it");
    collect(ui: ui);
    check(t: t, ok: !ui.elementChecked(handle: meter) && !ui.elementChecked(handle: 0), what: "nothing but a checkbox is checked");
    string byAttribute = "set as an attribute";
    ui.setElementAttribute(handle: field, name: "value", value: byAttribute);
    string asText = ui.elementText(handle: field);
    Seen attrQuiet = collect(ui: ui);
    check(t: t, ok: asText == byAttribute && attrQuiet.count == 0,
          what: "a `value` attribute is the field's text, written quietly ('${asText}', ${attrQuiet.count} events)");
    ui.removeElementAttribute(handle: field, name: "value");
    string emptied = ui.elementText(handle: field);
    check(t: t, ok: emptied == "", what: "...and removing it empties the field ('${emptied}')");
    ui.setElementAttribute(handle: 0, name: "hidden", value: "");
    ui.removeElementAttribute(handle: 0, name: "hidden");

    section(what: "the seam: a long value comes back whole");
    string big = longText();
    ui.setElementText(handle: field, text: big);
    string whole = ui.elementText(handle: field);
    isize bigBytes = big.length();
    isize wholeBytes = whole.length();
    check(t: t, ok: whole == big, what: "a ${bigBytes}-byte value with three-byte characters reads back whole (${wholeBytes})");
    ui.setElementText(handle: field, text: "");

    section(what: "the seam: one change per edit, for every kind of control");
    int32 notes = ui.bindElement(elementId: "notes");
    int32 picker = ui.bindElement(elementId: "pick");
    int32 choices = ui.bindElement(elementId: "choices");
    collect(ui: ui);
    typeInto(ui: ui, id: "field", text: "abc");
    int32 typedChanges = changesOn(ui: ui, handle: field);
    check(t: t, ok: typedChanges == 3, what: "three characters typed into a text field: three changes (${typedChanges})");
    typeInto(ui: ui, id: "notes", text: "xy");
    int32 notesChanges = changesOn(ui: ui, handle: notes);
    check(t: t, ok: notesChanges == 2, what: "two into a textarea: two (${notesChanges})");
    check(t: t, ok: ui.focusElement(handle: level), what: "the range takes the ring");
    press(ui: ui, key: UI_KEY_RIGHT);
    int32 stepped = changesOn(ui: ui, handle: level);
    check(t: t, ok: stepped == 1, what: "a range stepped once: one (${stepped})");
    ui.setElementValue(handle: level, value: 1.0);
    ui.update();
    press(ui: ui, key: UI_KEY_RIGHT);
    int32 pastEnd = changesOn(ui: ui, handle: level);
    float32 stillMax = ui.elementValue(handle: level);
    check(t: t, ok: pastEnd == 0 && stillMax == 1.0, what: "a range stepped past its end changes nothing: none (${pastEnd})");
    UiRect agreeBox = ui.elementRect(handle: agree);
    injectClick(ui: ui, x: centerX(r: agreeBox), y: centerY(r: agreeBox));
    int32 toggledOnce = changesOn(ui: ui, handle: agree);
    check(t: t, ok: toggledOnce == 1, what: "a checkbox toggled: one (${toggledOnce})");
    int32 choiceB = ui.findElement(elementId: "choice-b");
    UiRect cb = ui.elementRect(handle: choiceB);
    injectClick(ui: ui, x: centerX(r: cb), y: centerY(r: cb));
    int32 chose = changesOn(ui: ui, handle: choices);
    check(t: t, ok: chose == 1, what: "a radio chosen: one, though RmlUi unchecks its neighbour too (${chose})");
    check(t: t, ok: ui.elementChecked(handle: choiceB), what: "...and it is checked");
    pick(ui: ui, selectId: "pick", optionId: "pick-b");
    int32 picked = changesOn(ui: ui, handle: picker);
    string pickedValue = ui.elementText(handle: picker);
    check(t: t, ok: picked == 1 && pickedValue == "b", what: "an option picked: one ('${pickedValue}', ${picked})");
    check(t: t, ok: ui.focusElement(handle: field), what: "the text field takes the ring");
    press(ui: ui, key: UI_KEY_ENTER);
    int32 committed = changesOn(ui: ui, handle: field);
    check(t: t, ok: committed == 0, what: "ENTER in a text field is a commit, not an edit: none (${committed})");
    ui.setElementText(handle: field, text: "");

    section(what: "the seam: keys reach the document");
    ui.claimKey(key: UI_KEY_S, mods: UI_MOD_CTRL);
    check(t: t, ok: ui.focusElement(handle: first), what: "the ring is on first");
    collect(ui: ui);
    injectKey(ui: ui, code: UI_KEY_ESCAPE, mods: 0);
    Pressed esc = keysOf(ui: ui);
    check(t: t, ok: esc.count == 1 && esc.key == UI_KEY_ESCAPE && esc.mods == 0 && esc.element == 0 && esc.target == first,
          what: "Escape is one Key, the document's, naming the focused element (${esc.count}, target ${esc.target})");
    injectKey(ui: ui, code: UI_KEY_F2, mods: 0);
    Pressed f2 = keysOf(ui: ui);
    check(t: t, ok: f2.count == 1 && f2.key == UI_KEY_F2, what: "F2 is one (${f2.count})");
    injectKey(ui: ui, code: UI_KEY_PAGE_DOWN, mods: 0);
    Pressed pageDown = keysOf(ui: ui);
    check(t: t, ok: pageDown.count == 1 && pageDown.key == UI_KEY_PAGE_DOWN, what: "PageDown is one (${pageDown.count})");
    injectKey(ui: ui, code: UI_KEY_S, mods: UI_MOD_CTRL);
    Pressed save = keysOf(ui: ui);
    check(t: t, ok: save.count == 1 && save.key == UI_KEY_S && save.mods == UI_MOD_CTRL,
          what: "Ctrl+S is one, with its modifier, claimed or not (${save.count}, mods ${save.mods})");
    injectKey(ui: ui, code: UI_KEY_1, mods: UI_MOD_ALT);
    Pressed alt = keysOf(ui: ui);
    check(t: t, ok: alt.count == 1 && alt.key == UI_KEY_1 && alt.mods == UI_MOD_ALT, what: "Alt+1 is one (${alt.count})");
    injectKey(ui: ui, code: UI_KEY_S, mods: 0);
    injectKey(ui: ui, code: UI_KEY_S, mods: UI_MOD_SHIFT);
    Pressed typing = keysOf(ui: ui);
    check(t: t, ok: typing.count == 0, what: "a letter alone, or with Shift, is typing, not a Key (${typing.count})");

    section(what: "the seam: focus and blur, ancestors first");
    check(t: t, ok: ui.focusElement(handle: second), what: "focus moves from first to second");
    string moved = trace(ui: ui);
    check(t: t, ok: moved == "Blur:panel>first,Blur:first>first,Focus:panel>second,Focus:second>second",
          what: "...a Blur on first, then a Focus on second, each heard by the panel before the button ('${moved}')");
    UiRect meterBox = ui.elementRect(handle: meter);
    injectClick(ui: ui, x: centerX(r: meterBox), y: centerY(r: meterBox));
    string away = trace(ui: ui);
    check(t: t, ok: away == "Blur:panel>second,Blur:second>second,Click:meter>meter",
          what: "a press on what cannot hold the focus takes it away, and reports no Focus ('${away}')");

    section(what: "the seam: a double click, between its two clicks; modifiers on a click");
    UiRect lastBox = ui.elementRect(handle: last);
    collect(ui: ui);
    injectDoubleClick(ui: ui, x: centerX(r: lastBox), y: centerY(r: lastBox));
    string twice = kindsOn(ui: ui, handle: last);
    check(t: t, ok: twice == "Click,DoubleClick,Click", what: "two presses within half a second ('${twice}')");
    injectClick(ui: ui, x: centerX(r: lastBox), y: centerY(r: lastBox));
    injectClick(ui: ui, x: centerX(r: lastBox), y: centerY(r: lastBox));
    string spaced = kindsOn(ui: ui, handle: last);
    check(t: t, ok: spaced == "Click,Click", what: "two clicks half a second apart are two clicks ('${spaced}')");
    injectModClick(ui: ui, x: centerX(r: lastBox), y: centerY(r: lastBox), mods: UI_MOD_CTRL);
    Seen ctrl = collect(ui: ui);
    check(t: t, ok: ctrl.clicks == 2 && ctrl.first == last && ctrl.firstMods == UI_MOD_CTRL,
          what: "a Ctrl+click says Ctrl (${ctrl.firstMods})");
    injectModClick(ui: ui, x: centerX(r: lastBox), y: centerY(r: lastBox), mods: UI_MOD_SHIFT | UI_MOD_ALT);
    Seen shiftAlt = collect(ui: ui);
    check(t: t, ok: shiftAlt.firstMods == (UI_MOD_SHIFT | UI_MOD_ALT), what: "...and Shift+Alt says both (${shiftAlt.firstMods})");

    section(what: "the seam: drag and drop");
    int32 rowB = ui.findElement(elementId: "row-b");
    UiRect lbd = ui.elementRect(handle: list);
    float32 inner = lbd.width - 12.0;
    float32 dragX = lbd.x + 40.0;
    collect(ui: ui);
    dragBegin(ui: ui, fromX: dragX, fromY: lbd.y + 18.0, toX: dragX, toY: lbd.y + 42.0);
    collect(ui: ui);
    ui.update();
    UiRect dragging = ui.elementRect(handle: rowA);
    UiRect over = ui.elementRect(handle: rowB);
    check(t: t, ok: dragging.width == 200.0 && over.width == 250.0,
          what: "mid-drag the dragged row has `ui-dragging` and the row under the pointer `ui-drop-target` (${dragging.width}, ${over.width})");
    dragEnd(ui: ui);
    Seen dropped = collect(ui: ui);
    check(t: t, ok: dropped.drops == 1 && dropped.first == list && dropped.firstTarget == rowB && dropped.firstSource == rowA,
          what: "the drop is one Drop, heard by the list, target the row dropped on, source the row dragged (${dropped.drops}, ${dropped.firstTarget}, ${dropped.firstSource})");
    ui.update();
    UiRect after = ui.elementRect(handle: rowA);
    UiRect afterB = ui.elementRect(handle: rowB);
    check(t: t, ok: after.width == inner && afterB.width == inner, what: "...and both classes are gone (${after.width}, ${afterB.width})");
    ui.appendInnerRml(handle: list, rml: "<div id='row-c' draggable='true'><p>Gamma</p></div>");
    ui.update();
    int32 rowC = ui.findElement(elementId: "row-c");
    UiRect rc = ui.elementRect(handle: rowC);
    dragBegin(ui: ui, fromX: dragX, fromY: rc.y + 12.0, toX: dragX, toY: lbd.y + 18.0);
    dragEnd(ui: ui);
    Seen droppedC = collect(ui: ui);
    check(t: t, ok: droppedC.drops == 2 && droppedC.first == aName && droppedC.firstTarget == aName && droppedC.second == list &&
                    droppedC.firstSource == rowC,
          what: "an appended row with `draggable` drags too, onto the first row's text: bound, it hears the drop before the list (${droppedC.drops})");

    section(what: "the seam: plain text, never parsed");
    string plain = "<b>a & b</b> stays text";
    ui.setElementContent(handle: note, text: plain);
    string readBack = ui.elementContent(handle: note);
    check(t: t, ok: readBack == plain, what: "setElementContent writes text, elementContent reads it ('${readBack}')");
    ui.setElementText(handle: field, text: "kept");
    ui.setElementContent(handle: field, text: "ignored");
    string fieldKept = ui.elementText(handle: field);
    string fieldContent = ui.elementContent(handle: field);
    check(t: t, ok: fieldKept == "kept" && fieldContent == "", what: "...a form control ignores both ('${fieldKept}', '${fieldContent}')");
    ui.setElementText(handle: field, text: "");

    section(what: "the seam: a select's options rebuilt");
    collect(ui: ui);
    ui.setInnerRml(handle: picker, rml: "<option value='x'>X</option><option value='y' selected>Y</option>");
    ui.update();
    string rebuilt = ui.elementText(handle: picker);
    int32 options = ui.childCount(handle: picker);
    check(t: t, ok: rebuilt == "y" && options == 2, what: "a rewrite replaces the options, the value settling on `selected` ('${rebuilt}', ${options})");
    ui.appendInnerRml(handle: picker, rml: "<option value='z'>Z</option>");
    ui.update();
    int32 three = ui.childCount(handle: picker);
    string still = ui.elementText(handle: picker);
    check(t: t, ok: three == 3 && still == "y", what: "an append adds one, the value kept (${three}, '${still}')");
    int32 removedOption = ui.removeChildren(handle: picker, from: 0, count: 1);
    ui.update();
    int32 two = ui.childCount(handle: picker);
    string stillY = ui.elementText(handle: picker);
    check(t: t, ok: removedOption == 1 && two == 2 && stillY == "y",
          what: "a removal takes one (${removedOption}, ${two}, '${stillY}')");
    int32 rebuildChanges = changesOn(ui: ui, handle: picker);
    check(t: t, ok: rebuildChanges == 0, what: "...and none of it is a change (${rebuildChanges})");

    legTests(t: t, ui: ui, first: first, field: field);

    section(what: "the seam: closing the document, and one from text");
    ui.closeDocument();
    ui.update();
    check(t: t, ok: ui.bindElement(elementId: "first") == 0 && !ui.focusHeld(), what: "with no document nothing binds and nothing holds the ring");
    Seen none = collect(ui: ui);
    check(t: t, ok: none.count == 0, what: "...and nothing is queued");
    string text = seamText();
    check(t: t, ok: ui.loadDocumentText(rml: text), what: "a document loads from text");
    int32 only = ui.bindElement(elementId: "only");
    check(t: t, ok: only > 0 && ui.bindElement(elementId: "first") == 0, what: "...its element binds, and the old document's do not");
    ui.update();
    check(t: t, ok: ui.focusedElement() == only, what: "...and its autofocus holds the ring");
    ui.close();
    check(t: t, ok: !ui.isOpen(), what: "close() closes it");
}

// A PAGE (`openPage`): the document fills the window without `setViewport`, and scrolls in its own box. The size it
// fills, and how a wheel is turned, are each leg's (`pageLegTests`, `injectScroll`).
fn void pageTests(ref Tally t)
{
    section(what: "a page: open, fill the window, scroll a box");
    string font = fontPath();
    UiContext ui = UiContext.openPage(width: 800, height: 600, fontPath: font);
    check(t: t, ok: ui.isOpen(), what: "a page opens");
    if (!ui.isOpen()) { return; }
    ui.setDpRatio(ratio: 1.0);
    string text = pageText();
    check(t: t, ok: ui.loadDocumentText(rml: text), what: "...and loads a document");
    ui.update();
    int32 page = ui.bindElement(elementId: "page");
    int32 log = ui.bindElement(elementId: "log");
    int32 line1 = ui.bindElement(elementId: "line1");
    UiRect pr = ui.elementRect(handle: page);
    check(t: t, ok: pr.x == 0.0 && pr.y == 0.0 && pr.width > 0.0 && pr.height > 0.0,
          what: "it is shown with no setViewport, at the window's corner (${pr.width} x ${pr.height})");
    UiRect logBox = ui.elementRect(handle: log);
    UiRect before = ui.elementRect(handle: line1);
    check(t: t, ok: injectScroll(ui: ui, x: centerX(r: logBox), y: centerY(r: logBox), notches: 3.0),
          what: "the wheel is turned over the log");
    UiRect after = ui.elementRect(handle: line1);
    check(t: t, ok: after.y < before.y, what: "...and the log scrolls in its own box (${before.y} -> ${after.y})");
    UiRect logAfter = ui.elementRect(handle: log);
    check(t: t, ok: logAfter.y == logBox.y, what: "...while the page around it stays put");

    section(what: "a page: a log follows its newest line");
    string lines = "<p id='first-line'>line</p>";
    int32 n = 1;
    while (n < 19) {
        lines = "${lines}<p>line</p>";
        n = n + 1;
    }
    string withNewest = "${lines}<p id='newest'>newest</p>";
    ui.setInnerRml(handle: log, rml: withNewest);
    ui.scrollToEnd(handle: log);   // in the same frame as the write, before any update
    ui.update();
    int32 newest = ui.findElement(elementId: "newest");
    UiRect nr = ui.elementRect(handle: newest);
    UiRect lr = ui.elementRect(handle: log);
    float32 newestBottom = nr.y + nr.height;
    float32 logBottom = lr.y + lr.height;
    check(t: t, ok: newestBottom > logBottom - 1.0 && newestBottom < logBottom + 1.0,
          what: "scrollToEnd right after a write shows the newest line at the log's bottom (${newestBottom} of ${logBottom})");
    Seen scrolled = collect(ui: ui);
    check(t: t, ok: scrolled.count == 0, what: "...and the scroll raises nothing the program hears (${scrolled.count})");
    ui.scrollToEnd(handle: 0);
    ui.scrollToEnd(handle: page);
    ui.update();
    UiRect pageAfter = ui.elementRect(handle: page);
    check(t: t, ok: pageAfter.y == 0.0, what: "...a no-op for an unknown handle and for a box that does not scroll");

    section(what: "a page: a log appended to, followed only while it is read at its end");
    check(t: t, ok: ui.isScrolledToEnd(handle: log), what: "after scrollToEnd the log is at its end");
    check(t: t, ok: ui.isScrolledToEnd(handle: page) && !ui.isScrolledToEnd(handle: 0),
          what: "a box that cannot scroll is at its end; an unknown handle is not");
    int32 newestBound = ui.bindElement(elementId: "newest");
    ui.setElementClass(handle: newestBound, name: "marked", on: true);
    ui.update();
    collect(ui: ui);
    bool follow = ui.isScrolledToEnd(handle: log);
    ui.appendInnerRml(handle: log, rml: "<p id='a1'>a1</p>");
    if (follow) { ui.scrollToEnd(handle: log); }
    check(t: t, ok: ui.isScrolledToEnd(handle: log), what: "...and still reads so between the append and the update");
    ui.update();
    int32 a1 = ui.findElement(elementId: "a1");
    UiRect a1r = ui.elementRect(handle: a1);
    UiRect lr2 = ui.elementRect(handle: log);
    float32 a1Bottom = a1r.y + a1r.height;
    float32 logBottom2 = lr2.y + lr2.height;
    check(t: t, ok: a1Bottom > logBottom2 - 1.0 && a1Bottom < logBottom2 + 1.0,
          what: "at its end, an append and scrollToEnd show the appended line at the bottom (${a1Bottom} of ${logBottom2})");
    // Clicked BEFORE its handle is used again: the append itself must have put its listener back.
    injectClick(ui: ui, x: centerX(r: a1r), y: a1r.y - 15.0);
    Seen onKept = collect(ui: ui);
    check(t: t, ok: onKept.count == 3 && onKept.first == newestBound,
          what: "the line before it still hears its clicks: its own, then the log's and the page's (${onKept.count})");
    UiRect kept = ui.elementRect(handle: newestBound);
    check(t: t, ok: newestBound == newest && kept.height == 30.0 && kept.y + kept.height == a1r.y,
          what: "...kept, in order, its handle still naming it (${kept.y} + ${kept.height} = ${a1r.y})");
    check(t: t, ok: kept.x == lr2.x + 10.0, what: "...with the class it was given (x ${kept.x}, the log's ${lr2.x})");
    check(t: t, ok: injectScroll(ui: ui, x: centerX(r: lr2), y: centerY(r: lr2), notches: -2.0), what: "the reader scrolls up");
    check(t: t, ok: !ui.isScrolledToEnd(handle: log), what: "...and the log is no longer at its end");
    UiRect reading = ui.elementRect(handle: newestBound);
    bool followUp = ui.isScrolledToEnd(handle: log);
    ui.appendInnerRml(handle: log, rml: "<p id='a2'>a2</p>");
    if (followUp) { ui.scrollToEnd(handle: log); }
    ui.update();
    UiRect stillReading = ui.elementRect(handle: newestBound);
    check(t: t, ok: stillReading.y == reading.y, what: "an append while reading above leaves the reader where they were (${reading.y} -> ${stillReading.y})");
    int32 a2 = ui.findElement(elementId: "a2");
    UiRect a2r = ui.elementRect(handle: a2);
    check(t: t, ok: a2 > 0 && a2r.y >= logBottom2 && !ui.isScrolledToEnd(handle: log),
          what: "...the new line below the fold, not followed (${a2r.y})");
    ui.scrollToEnd(handle: log);
    check(t: t, ok: ui.isScrolledToEnd(handle: log), what: "a pending scrollToEnd reads as at the end");
    ui.update();
    UiRect a2end = ui.elementRect(handle: a2);
    check(t: t, ok: ui.isScrolledToEnd(handle: log) && a2end.y + a2end.height > logBottom2 - 1.0,
          what: "...and the next update puts the newest line at the bottom");
    ui.appendInnerRml(handle: 0, rml: "<p>x</p>");

    section(what: "a page: a log scrolled to a line, trimmed of its oldest");
    int32 firstLine = ui.findElement(elementId: "first-line");
    ui.scrollIntoView(handle: firstLine);
    ui.update();
    UiRect fl = ui.elementRect(handle: firstLine);
    UiRect lt = ui.elementRect(handle: log);
    check(t: t, ok: fl.y == lt.y, what: "scrollIntoView puts a line at the top of the log (${fl.y} of ${lt.y})");
    int32 lines0 = ui.childCount(handle: log);
    int32 trimmed = ui.removeChildren(handle: log, from: 0, count: 5);
    ui.update();
    int32 lines1 = ui.childCount(handle: log);
    UiRect firstGone = ui.elementRect(handle: firstLine);
    UiRect stillThere = ui.elementRect(handle: newestBound);
    check(t: t, ok: trimmed == 5 && lines1 == lines0 - 5, what: "removeChildren drops the oldest five (${lines0} -> ${lines1})");
    check(t: t, ok: firstGone.height == 0.0 && stillThere.height == 30.0,
          what: "...a handle to a removed line is stale, one to a kept line still names it");
    int32 beyond = ui.removeChildren(handle: log, from: lines1, count: 3);
    check(t: t, ok: beyond == 0 && ui.childCount(handle: log) == lines1, what: "...and a range past the end removes nothing");

    section(what: "a page: a tooltip from `title`");
    int32 bar = ui.findElement(elementId: "bar");
    int32 tip = ui.findElement(elementId: "kama-ui-tooltip");
    UiRect barBox = ui.elementRect(handle: bar);
    float32 hx = barBox.x + 20.0;
    float32 hy = barBox.y + 10.0;
    check(t: t, ok: tip > 0, what: "the package's tooltip element is in the document");
    injectHover(ui: ui, x: hx, y: hy);
    int32 frames = 0;
    while (frames < 10) {
        ui.update();
        frames = frames + 1;
    }
    string early = ui.elementContent(handle: tip);
    check(t: t, ok: early == "", what: "a sixth of a second in, nothing shows ('${early}')");
    while (frames < 35) {
        ui.update();
        frames = frames + 1;
    }
    string shown = ui.elementContent(handle: tip);
    UiRect tipBox = ui.elementRect(handle: tip);
    check(t: t, ok: shown == "The tool bar", what: "past half a second the title shows ('${shown}')");
    check(t: t, ok: tipBox.x > hx + 11.0 && tipBox.x < hx + 13.0 && tipBox.y > hy + 15.0 && tipBox.y < hy + 17.0,
          what: "...12 px right of and 16 px below the pointer (${tipBox.x}, ${tipBox.y} for ${hx}, ${hy})");
    UiRect logHover = ui.elementRect(handle: log);
    injectHover(ui: ui, x: centerX(r: logHover), y: centerY(r: logHover));
    ui.update();
    string left = ui.elementContent(handle: tip);
    check(t: t, ok: left == "", what: "leaving the element hides it ('${left}')");
    injectHover(ui: ui, x: hx, y: hy);
    frames = 0;
    while (frames < 35) {
        ui.update();
        frames = frames + 1;
    }
    check(t: t, ok: ui.elementContent(handle: tip) == "The tool bar", what: "hovered again, it shows again");
    injectClick(ui: ui, x: hx, y: hy);
    frames = 0;
    while (frames < 40) {
        ui.update();
        frames = frames + 1;
    }
    string pressed = ui.elementContent(handle: tip);
    check(t: t, ok: pressed == "", what: "a press hides it, and it stays hidden while the same element is hovered ('${pressed}')");
    injectHover(ui: ui, x: centerX(r: logHover), y: centerY(r: logHover));
    ui.update();
    injectHover(ui: ui, x: hx, y: hy);
    frames = 0;
    while (frames < 35) {
        ui.update();
        frames = frames + 1;
    }
    check(t: t, ok: ui.elementContent(handle: tip) == "The tool bar", what: "another element hovered and back: it shows");
    injectScroll(ui: ui, x: hx, y: hy, notches: 1.0);
    string wheeled = ui.elementContent(handle: tip);
    check(t: t, ok: wheeled == "", what: "the wheel hides it ('${wheeled}')");
    collect(ui: ui);

    pageLegTests(t: t, ui: ui, page: page);
    ui.close();
    check(t: t, ok: !ui.isOpen(), what: "the page closes");

    section(what: "a stage again, after the page");
    UiContext stage = UiContext.open(width: 1280, height: 720, fontPath: font);
    stage.setDpRatio(ratio: 1.0);
    stage.setViewport(offsetX: 0.0, offsetY: 0.0, scale: 1.0, visible: true);
    string again = seamText();
    check(t: t, ok: stage.loadDocumentText(rml: again), what: "a stage opens after a page and loads a document");
    stage.update();
    int32 box = stage.bindElement(elementId: "box");
    UiRect boxRect = stage.elementRect(handle: box);
    check(t: t, ok: boxRect.width == 1280.0, what: "...shown by setViewport at its own virtual width (${boxRect.width})");
    stage.close();
}
