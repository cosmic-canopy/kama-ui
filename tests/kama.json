{
  "name": "ui_tests",
  "version": "0.1.0",
  "kind": "executable",
  "kama": ">=0.9.577",
  "entry": "src/main.kama",
  "dependencies": {
    "@kama/ui": { "path": ".." },
    "@kama/rmlui": { "path": "../../kama-rmlui" }
  },
  "modules": { ".": { "visibility": "internal" } },
  "cincludes": ["web"],
  "jsLibraries": ["web/kama_ui_test.js"],
  "select": {
    "TARGET": {
      "HOST":    { "ldflags": ["-L../kama-rmlui/native/build/linux/lib", "-L../kama-rmlui/native/build/darwin/lib",
                               "-L../kama-rmlui/native/build/windows/lib"] },
      "LINUX":   { "ldflags": ["-L../kama-rmlui/native/build/linux/lib"] },
      "MACOS":   { "ldflags": ["-L../kama-rmlui/native/build/darwin/lib"] },
      "WINDOWS": { "ldflags": ["-L../kama-rmlui/native/build/windows/lib", "-static-libgcc", "-Wl,-Bstatic", "-lstdc++",
                               "-lpthread", "-Wl,-Bdynamic"] },
      "WASM":    { "ldflags": ["--embed-file", "tests/fixtures/seam.rml"] }
    }
  }
}
