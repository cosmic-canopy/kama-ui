{
  "name": "ui_tests",
  "version": "0.1.0",
  "kind": "executable",
  "kama": ">=0.9.758",
  "entry": "src/main.kama",
  "dependencies": {
    "@kama/ui": { "path": ".." }
  },
  "modules": { ".": { "visibility": "internal" } },
  "cincludes": ["web"],
  "jsLibraries": ["web/kama_ui_test.js"],
  "select": {
    "TARGET": {
      "WINDOWS": { "ldflags": ["-static-libgcc", "-Wl,-Bstatic", "-lstdc++", "-lpthread", "-Wl,-Bdynamic"] },
      "WASM":    { "ldflags": ["--embed-file", "tests/fixtures/seam.rml"] }
    }
  }
}
