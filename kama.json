{
  "name": "@kama/ui",
  "version": "0.5.0",
  "license": "MIT OR Apache-2.0",
  "kind": "library",
  "kama": ">=0.9.577",
  "description": "One set of HTML documents for kama UIs: the browser's own DOM on the web, RmlUi natively",
  "keywords": ["ui", "html", "dom", "rmlui", "gui"],
  "repository": "https://github.com/cosmic-canopy/kama-ui",
  "publish": {
    "exclude": [
      "tools/", "tests/",
      "AGENTS.md", "AGENTS.package.md", "AGENTS.ui.md", "CLAUDE.md", "KAMA_GAPS.md"
    ]
  },
  "modules": {
    ".":     { "visibility": "public" },
    "uidoc": { "visibility": "public" }
  },
  "dependencies": {
    "@kama/rmlui": { "version": "^0.2.0" }
  },
  "cincludes": ["src"],
  "jsLibraries": ["src/kama_ui_web.js"],
  "emSettings": {
    "EXPORTED_RUNTIME_METHODS": ["HEAP32", "HEAPF32", "HEAPU8"]
  }
}
